<div class="contact-form__row"><label for="FirstName-{{ id }}">First name<input id="FirstName-{{ id }}" name="address[first_name]" value="{{ form.first_name | escape }}" autocomplete="given-name" required></label><label for="LastName-{{ id }}">Last name<input id="LastName-{{ id }}" name="address[last_name]" value="{{ form.last_name | escape }}" autocomplete="family-name" required></label></div>
<label for="Company-{{ id }}">Company<input id="Company-{{ id }}" name="address[company]" value="{{ form.company | escape }}" autocomplete="organization"></label>
<label for="Address1-{{ id }}">Address<input id="Address1-{{ id }}" name="address[address1]" value="{{ form.address1 | escape }}" autocomplete="address-line1" required></label>
<label for="Address2-{{ id }}">Apartment, suite, etc.<input id="Address2-{{ id }}" name="address[address2]" value="{{ form.address2 | escape }}" autocomplete="address-line2"></label>
<label for="City-{{ id }}">City<input id="City-{{ id }}" name="address[city]" value="{{ form.city | escape }}" autocomplete="address-level2" required></label>
<label for="Country-{{ id }}">Country<select id="Country-{{ id }}" name="address[country]" data-address-country data-default="{{ form.country | escape }}" data-province-id="Province-{{ id }}" autocomplete="country-name">{{ all_country_option_tags }}</select></label>
<label for="Province-{{ id }}">State / province<input id="Province-{{ id }}" name="address[province]" value="{{ form.province | escape }}" autocomplete="address-level1" data-province-value="{{ form.province | escape }}"></label>
<div class="contact-form__row"><label for="Zip-{{ id }}">Postal code<input id="Zip-{{ id }}" name="address[zip]" value="{{ form.zip | escape }}" autocomplete="postal-code"></label><label for="Phone-{{ id }}">Phone<input id="Phone-{{ id }}" type="tel" name="address[phone]" value="{{ form.phone | escape }}" autocomplete="tel"></label></div>
<label class="checkbox-label">{{ form.set_as_default_checkbox }} Set as default address</label>
