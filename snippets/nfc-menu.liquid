{%- if menu.links != blank -%}
  {%- for link in menu.links -%}
    {%- if link.links != blank -%}
      <details class="nav-dropdown" name="{{ disclosure_group }}">
        <summary>{{ link.title | escape }}</summary>
        <div class="nav-dropdown__links">
          {%- if link.url != blank and link.url != '#' -%}
            <a href="{{ link.url | escape }}"{% if link.current %} aria-current="page"{% endif %}>{{ link.title | escape }}</a>
          {%- endif -%}
          {%- for child in link.links -%}
            <a href="{{ child.url | escape }}"{% if child.current %} aria-current="page"{% endif %}>{{ child.title | escape }}</a>
            {%- for grandchild in child.links -%}
              <a class="nav-grandchild" href="{{ grandchild.url | escape }}"{% if grandchild.current %} aria-current="page"{% endif %}>{{ grandchild.title | escape }}</a>
            {%- endfor -%}
          {%- endfor -%}
        </div>
      </details>
    {%- else -%}
      <a href="{{ link.url | escape }}"{% if link.current %} aria-current="page"{% endif %}>{{ link.title | escape }}</a>
    {%- endif -%}
  {%- endfor -%}
{%- else -%}
  <a href="{{ routes.root_url }}">Home</a>
  <a href="{{ routes.all_products_collection_url }}">Shop all</a>
  <a href="{{ routes.root_url }}pages/contact">Contact</a>
  <a href="{{ routes.root_url }}pages/faq">FAQ</a>
{%- endif -%}
