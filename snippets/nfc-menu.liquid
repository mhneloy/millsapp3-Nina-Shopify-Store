{% if menu != blank %}{% for link in menu.links %}{% if link.links != blank %}<details class="nav-dropdown"><summary>{{ link.title | escape }}</summary><div><a href="{{ link.url }}">{{ link.title | escape }}</a>{% for child in link.links %}<a href="{{ child.url }}">{{ child.title | escape }}</a>{% for grandchild in child.links %}<a class="nav-grandchild" href="{{ grandchild.url }}">{{ grandchild.title | escape }}</a>{% endfor %}{% endfor %}</div></details>{% else %}<a href="{{ link.url }}" {% if link.current %}aria-current="page"{% endif %}>{{ link.title | escape }}</a>{% endif %}{% endfor %}
{% else %}<a href="{{ routes.root_url }}">Home</a><a href="{{ routes.all_products_collection_url }}">Shop all</a><a href="{{ routes.root_url }}pages/contact">Contact</a><a href="{{ routes.root_url }}pages/faq">FAQ</a>{% endif %}
