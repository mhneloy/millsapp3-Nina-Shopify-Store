<dialog id="NfcSearch" class="nfc-dialog search-dialog" aria-labelledby="NfcSearchHeading">
  <div class="dialog-heading"><h2 id="NfcSearchHeading">Search products</h2><button class="nfc-button nfc-button--icon" data-close-dialog aria-label="Close search">{% render 'nfc-icon', name: 'close' %}</button></div>
  <form class="search-dialog__form" data-header-search role="search" action="{{ routes.all_products_collection_url }}" method="get">
    <label class="sr-only" for="NfcSearchInput">Product name</label><input id="NfcSearchInput" type="search" name="q" placeholder="Search by product name" autocomplete="off" autofocus aria-controls="NfcSearchResults" aria-describedby="NfcSearchStatus">
    <button class="nfc-button nfc-button--icon" type="submit" aria-label="Search products">{% render 'nfc-icon', name: 'search' %}</button>
  </form>
  <p id="NfcSearchStatus" class="form-note" role="status">Type a product name to find your next piece.</p>
  <div id="NfcSearchResults" class="search-suggestions"></div>
</dialog>
<dialog id="NfcCart" class="nfc-dialog cart-sheet" aria-labelledby="NfcCartHeading">
  <div class="dialog-heading"><div><p class="cart-sheet__eyebrow">FAITH IN EVERY FIT</p><h2 id="NfcCartHeading">{{ settings.nfc_cart_heading | escape }}</h2></div><button class="nfc-button nfc-button--icon" data-close-dialog aria-label="Close bag">{% render 'nfc-icon', name: 'close' %}</button></div>
  <p class="dialog-status" data-cart-status role="status"></p>
  <div data-cart-content></div>
  <div class="cart-summary" data-cart-summary hidden><div class="cart-summary__total"><span>Subtotal</span><span data-cart-total></span></div><p>{{ settings.nfc_shipping_note | escape }}</p><form action="{{ routes.cart_url }}" method="post"><button class="nfc-button nfc-button--dark cart-checkout" name="checkout" type="submit">Checkout {% render 'nfc-icon', name: 'arrow' %}</button></form><a class="nfc-button nfc-button--line" href="{{ routes.cart_url }}">View bag</a></div>
</dialog>
<dialog id="NfcQuickView" class="nfc-dialog quick-view-sheet" aria-labelledby="QuickViewHeading"><div class="dialog-heading"><p class="eyebrow">A CLOSER LOOK</p><button class="nfc-button nfc-button--icon" data-close-dialog aria-label="Close quick view">{% render 'nfc-icon', name: 'close' %}</button></div><div data-quick-content><h2 id="QuickViewHeading">Product details</h2></div></dialog>
