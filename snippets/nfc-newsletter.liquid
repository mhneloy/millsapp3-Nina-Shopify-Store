{% assign newsletter_id = 'Newsletter-' | append: id %}
{% form 'customer', id: newsletter_id, class: 'newsletter-form' %}
  <input type="hidden" name="contact[tags]" value="newsletter">
  <label class="{% if compact %}sr-only{% endif %}" for="Email-{{ id }}">Email address</label>
  <div class="newsletter-form__row"><input id="Email-{{ id }}" type="email" name="contact[email]" placeholder="you@example.com" autocomplete="email" autocapitalize="off" required {% if form.errors %}aria-invalid="true" aria-describedby="NewsletterError-{{ id }}"{% endif %}>
  <button class="nfc-button nfc-button--dark" type="submit">{{ label | default: 'Subscribe' | escape }} {% render 'nfc-icon', name: 'arrow' %}</button></div>
  {% if form.posted_successfully? %}<p class="form-note" role="status">Thank you for subscribing.</p>{% endif %}
  {% if form.errors %}<div id="NewsletterError-{{ id }}" role="alert">{{ form.errors | default_errors }}</div>{% endif %}
{% endform %}
