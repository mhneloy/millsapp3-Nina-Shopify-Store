<!-- site-logo.liquid -->

{%- liquid

  assign logo_max_width = section.settings.logo_max_width

  assign logodark = section.settings.logo

  assign logowhite = section.settings.logo_white

  assign logo_font_family = section.settings.logo_font_family | default: 'Cinzel'

  assign logo_text_size = section.settings.logo_text_size | default: 24

  assign logo_text_size_mobile = section.settings.logo_text_size_mobile | default: 16

  assign logo_font_weight = section.settings.logo_font_weight | default: '800'

  assign logo_letter_spacing = section.settings.logo_letter_spacing | default: 2

  assign enable_logo_shimmer = section.settings.enable_logo_shimmer

  if enable_logo_shimmer == nil

    assign enable_logo_shimmer = true

  endif

  assign logo_shimmer_speed = section.settings.logo_shimmer_speed | default: 3

-%}

<style>

  :root {

    --logo-font-family: {% case logo_font_family %}{% when 'Cinzel' %}'Cinzel', serif{% when 'Playfair Display' %}'Playfair Display', serif{% when 'Montserrat' %}'Montserrat', sans-serif{% when 'Jost' %}'Jost', sans-serif{% else %}'Cormorant Garamond', Georgia, serif{% endcase %};

    --logo-font-size-desk: {{ logo_text_size }}px;

    --logo-font-size-mobile: {{ logo_text_size_mobile }}px;

    --logo-font-weight: {{ logo_font_weight }};

    --logo-letter-spacing: {{ logo_letter_spacing }}px;

  }

  .site-header__logo img { width: {{ logo_max_width | append: 'px' }}; }

  .site-header__logo.has-logo { font-size: 0; line-height: 0; }

  .site-header__logo.has-logo a { font-size: 0; line-height: 0; }

  .site-header__logo:not(.has-logo) { line-height: 1.2 !important; }



  .site-header__logo:not(.has-logo) a { 

    display: inline-block !important;

    line-height: 1.2 !important; 

    white-space: nowrap !important;

    font-family: var(--logo-font-family, 'Cinzel', serif) !important;

    {% comment %} font-size: var(--logo-font-size-desk, 24px) !important; {% endcomment %}

    font-weight: var(--logo-font-weight, 800) !important;

    letter-spacing: var(--logo-letter-spacing, 2px) !important;

    text-transform: uppercase !important;

    text-decoration: none !important;

    -webkit-font-smoothing: antialiased;

    -moz-osx-font-smoothing: grayscale;

  }



  /* Shimmer Animation: EXACTLY as Hero Section Heading */

  @-webkit-keyframes goldShimmerBackAndForth {

    0% {

      background-position: 0% 50%;

    }

    100% {

      background-position: 100% 50%;

    }

  }

  @keyframes goldShimmerBackAndForth {

    0% {

      background-position: 0% 50%;

    }

    100% {

      background-position: 100% 50%;

    }

  }



  .site-header__logo a.site-header__logo-shimmer {

    background: {%- if section.settings.logo_shimmer_gradient != blank -%}{{ section.settings.logo_shimmer_gradient }}{%- else -%}linear-gradient(105deg, #C69E58 0%, #F3DD99 25%, #AF874D 50%, #EDD696 75%, #D9BA77 100%){%- endif -%} !important;

    background-size: 250% auto !important;

    -webkit-background-clip: text !important;

    -webkit-text-fill-color: transparent !important;

    background-clip: text !important;

    color: transparent !important;

    display: inline-block !important;

    vertical-align: middle !important;

    text-shadow: none !important;

    filter: drop-shadow(0 2px 8px rgba(0, 0, 0, 0.35));

    {% if enable_logo_shimmer != false %}

      -webkit-animation: goldShimmerBackAndForth {{ logo_shimmer_speed }}s ease-in-out infinite alternate !important;

      animation: goldShimmerBackAndForth {{ logo_shimmer_speed }}s ease-in-out infinite alternate !important;

    {% endif %}

    will-change: background-position;

  }



  .site-header__logo a.site-header__logo-shimmer:hover {

    filter: brightness(1.15) drop-shadow(0 2px 12px rgba(243, 221, 153, 0.5));

  }



  .site-header__logo a:not(.site-header__logo-shimmer) {

    color: #D9BA77 !important;

  }

</style>

{%- if template.name == 'index' -%}

<h1 class="site-header__logo {% if logodark != blank %} has-logo {% endif %}" itemscope itemtype="http://schema.org/Organization">

  {%- else -%}

  <div class="site-header__logo h1" itemscope itemtype="http://schema.org/Organization">

    {%- endif -%}

    {%- if logodark != blank -%}

    {%- capture image_size -%}{{ logo_max_width }}x{%- endcapture -%}

    <a href="{{ routes.root_url }}" itemprop="url" class="site-header__logo-link">

           {%-liquid

            assign maxlogo =  logo_max_width | times: 2   

          -%}

           {{ logodark | image_url: width: maxlogo | image_tag:

            class: 'logo-dark',

            widths: '50, 100, 150, 200, 250, 300, 400, 500',

            height: logodark.height,

            width: logodark.width,

            alt: shop.name

          }}

          {%- if logowhite != blank -%}

            {{ logowhite | image_url: width: maxlogo | image_tag:

              class: 'logo-white d-none',

              widths: '50, 100, 150, 200, 250, 300, 400, 500',

              height: logowhite.height,

              width: logowhite.width,

              alt: shop.name

            }}

        {%- endif -%}



    </a>

    {%- else -%}

    {%- assign shop_name_length = shop.name.size -%}

    <a href="/" itemprop="url" class="{% if shop_name_length > 10 %}site-header__shop-name--small {% endif %}{% if enable_logo_shimmer %}site-header__logo-shimmer{% endif %}">

      {{- shop.name -}}

    </a>

    {%- endif -%}

    {%- if template.name != 'index' -%}

  </div>

  {%- else -%}

</h1>

{%- endif -%}

