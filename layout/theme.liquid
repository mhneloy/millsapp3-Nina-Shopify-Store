<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <meta name="theme-color" content="{{ settings.nfc_background }}">
  <link rel="canonical" href="{{ canonical_url }}">
  <link rel="preconnect" href="https://cdn.shopify.com" crossorigin>
  <link rel="preconnect" href="https://fonts.shopifycdn.com" crossorigin>
  {% if settings.favicon != blank %}<link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32 }}">{% endif %}
  <title>{{ page_title }}{% if current_tags %} — {{ current_tags | join: ', ' }}{% endif %}{% if current_page != 1 %} — Page {{ current_page }}{% endif %}{% unless page_title contains shop.name %} — {{ shop.name }}{% endunless %}</title>
  {% if page_description %}<meta name="description" content="{{ page_description | escape }}">{% endif %}
  {% render 'social-meta-tags' %}
  {% style %}
    {{ settings.nfc_body_font | font_face: font_display: 'swap' }}
    {{ settings.nfc_heading_font | font_face: font_display: 'swap' }}
    {% assign body_bold = settings.nfc_body_font | font_modify: 'weight', '700' %}
    {{ body_bold | font_face: font_display: 'swap' }}
    :root{--background:{{ settings.nfc_background | default: '#faf9f6' }};--paper:{{ settings.nfc_paper | default: '#f5f3ee' }};--ink:{{ settings.nfc_ink | default: '#171717' }};--gold:{{ settings.nfc_gold | default: '#bca476' }};--blue:{{ settings.nfc_blue | default: '#357c9a' }};--line:{{ settings.nfc_line | default: "#deddd7" }};--soft-ink:{{ settings.nfc_muted | default: "#737373" }};--on-dark:{{ settings.nfc_on_dark | default: "#fafafa" }};--font-sans:{{ settings.nfc_body_font.family | default: 'DM Sans' }},{{ settings.nfc_body_font.fallback_families | default: 'sans-serif' }};--font-display:{{ settings.nfc_heading_font.family | default: 'Space Grotesk' }},{{ settings.nfc_heading_font.fallback_families | default: 'sans-serif' }};--page-width:{{ settings.nfc_page_width | default: 1440 }}px}
  {% endstyle %}
  {{ 'nfc-storefront.css' | asset_url | stylesheet_tag }}
  {{ 'nfc-custom.css' | asset_url | stylesheet_tag }}
  <script src="{{ 'nfc-storefront.js' | asset_url }}" defer></script>
  {{ content_for_header }}
</head>
<body class="nfc-storefront template-{{ request.page_type | handle }}">
  <a class="skip-link" href="#MainContent">Skip to content</a>
  {% sections 'nfc-header-group' %}
  <main id="MainContent" class="storefront-content" tabindex="-1">{{ content_for_layout }}</main>
  {% sections 'nfc-footer-group' %}
  {% render 'nfc-dialogs' %}
  <script type="application/json" id="NfcConfig">{"root":{{ routes.root_url | json }},"cartUrl":{{ routes.cart_url | json }},"moneyFormat":{{ shop.money_format | json }},"currency":{{ cart.currency.iso_code | default: shop.currency | json }},"addLabel":{{ settings.nfc_add_label | default: 'Add to bag' | json }},"soldOutLabel":{{ settings.nfc_sold_out_label | default: 'Sold out' | json }},"cartHeading":{{ settings.nfc_cart_heading | default: 'YOUR BAG' | json }},"emptyCart":{{ settings.nfc_empty_cart | default: 'Your bag is waiting.' | json }}}</script>
</body>
</html>
