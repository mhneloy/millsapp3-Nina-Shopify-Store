{% render 'nfc-section-style', section: section %}
<section class="campaign-hero" style="--hero-height:{{ section.settings.height }}px;--hero-shade:{{ section.settings.overlay | divided_by: 100.0 }}" aria-labelledby="HeroTitle-{{ section.id }}">
{% render 'nfc-image', image: section.settings.image, fallback: 'nfc-campaign-hero.jpg', class: 'campaign-hero__image', alt: section.settings.image_alt, loading: 'eager', sizes: '100vw' %}<div class="campaign-hero__shade"></div>
<div class="campaign-hero__content page-width"><p class="eyebrow campaign-hero__eyebrow">{{ section.settings.eyebrow | escape }}</p><h1 id="HeroTitle-{{ section.id }}">{{ section.settings.heading | escape | newline_to_br }}</h1><p class="campaign-hero__copy">{{ section.settings.copy | escape }}</p><div class="campaign-hero__actions"><a class="nfc-button nfc-button--hero" href="{{ section.settings.button_link | default: routes.all_products_collection_url }}">{{ section.settings.button_label | escape }} {% render 'nfc-icon', name: 'arrow' %}</a><a class="hero-text-link" href="{{ section.settings.secondary_link | default: routes.all_products_collection_url }}">{{ section.settings.secondary_label | escape }} {% render 'nfc-icon', name: 'arrow' %}</a></div></div>
<a class="campaign-hero__scroll" href="#collection" aria-label="Explore the collection">{% render 'nfc-icon', name: 'down' %}</a><span class="campaign-hero__index">{{ section.settings.index_label | escape }}</span></section>
{% schema %}
{
  "name": "NFC campaign hero",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "NUTS FOR CHRIST · STREETWEAR"
    },
    {
      "type": "textarea",
      "id": "heading",
      "label": "Heading",
      "default": "WEAR\nYOUR FAITH."
    },
    {
      "type": "text",
      "id": "copy",
      "label": "Description",
      "default": "Bold streetwear. Powerful messages. Faith expressed through every fit."
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Campaign image"
    },
    {
      "type": "text",
      "id": "image_alt",
      "label": "Image description",
      "default": "Streetwear editorial campaign showing models in black and white apparel"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Shop the collection"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "text",
      "id": "secondary_label",
      "label": "Secondary link label",
      "default": "Explore hoodies"
    },
    {
      "type": "url",
      "id": "secondary_link",
      "label": "Secondary link"
    },
    {
      "type": "text",
      "id": "index_label",
      "label": "Campaign index",
      "default": "01 / 03"
    },
    {
      "type": "range",
      "id": "height",
      "label": "Desktop height",
      "min": 500,
      "max": 1000,
      "step": 20,
      "unit": "px",
      "default": 800
    },
    {
      "type": "range",
      "id": "overlay",
      "label": "Overlay opacity",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 85
    },
    {
      "type": "header",
      "content": "Section colors"
    },
    {
      "type": "paragraph",
      "content": "Leave a color empty to keep the original design. These controls affect only this section."
    },
    {
      "type": "color",
      "id": "nfc_background_color",
      "label": "Background"
    },
    {
      "type": "color",
      "id": "nfc_heading_color",
      "label": "Headings"
    },
    {
      "type": "color",
      "id": "nfc_text_color",
      "label": "Paragraphs and body text"
    },
    {
      "type": "color",
      "id": "nfc_eyebrow_color",
      "label": "Eyebrow text"
    },
    {
      "type": "color",
      "id": "nfc_link_color",
      "label": "Links"
    },
    {
      "type": "color",
      "id": "nfc_accent_color",
      "label": "Accents"
    },
    {
      "type": "color",
      "id": "nfc_border_color",
      "label": "Borders and dividers"
    },
    {
      "type": "header",
      "content": "Section buttons"
    },
    {
      "type": "color",
      "id": "nfc_button_text",
      "label": "Button text and icons"
    },
    {
      "type": "color",
      "id": "nfc_button_background",
      "label": "Filled button background"
    },
    {
      "type": "color",
      "id": "nfc_button_border",
      "label": "Button border"
    },
    {
      "type": "color",
      "id": "nfc_button_hover_text",
      "label": "Button hover text"
    },
    {
      "type": "color",
      "id": "nfc_button_hover_background",
      "label": "Filled button hover background"
    },
    {
      "type": "header",
      "content": "Section layout"
    },
    {
      "type": "select",
      "id": "nfc_content_position",
      "label": "Content column position",
      "default": "default",
      "options": [
        {
          "value": "default",
          "label": "Original design"
        },
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ]
    },
    {
      "type": "select",
      "id": "nfc_text_alignment",
      "label": "Heading alignment",
      "default": "default",
      "options": [
        {
          "value": "default",
          "label": "Original design"
        },
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ]
    },
    {
      "type": "checkbox",
      "id": "nfc_custom_width",
      "label": "Customize content width",
      "default": false
    },
    {
      "type": "range",
      "id": "nfc_content_width",
      "label": "Content width",
      "min": 480,
      "max": 1600,
      "step": 20,
      "default": 1440,
      "unit": "px"
    },
    {
      "type": "header",
      "content": "Section typography"
    },
    {
      "type": "checkbox",
      "id": "nfc_custom_typography",
      "label": "Customize text sizes",
      "default": false
    },
    {
      "type": "range",
      "id": "nfc_heading_size",
      "label": "Heading size on desktop",
      "min": 20,
      "max": 140,
      "step": 2,
      "default": 56,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "nfc_heading_size_mobile",
      "label": "Heading size on mobile",
      "min": 20,
      "max": 100,
      "step": 2,
      "default": 36,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "nfc_paragraph_size",
      "label": "Paragraph size on desktop",
      "min": 10,
      "max": 30,
      "step": 1,
      "default": 14,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "nfc_paragraph_size_mobile",
      "label": "Paragraph size on mobile",
      "min": 10,
      "max": 30,
      "step": 1,
      "default": 14,
      "unit": "px"
    },
    {
      "type": "header",
      "content": "Section padding"
    },
    {
      "type": "text",
      "id": "nfc_padding_desktop",
      "label": "Padding on desktop",
      "info": "Top right bottom left. Example: 60px 20px 60px 20px. Leave blank to keep the design defaults."
    },
    {
      "type": "text",
      "id": "nfc_padding_mobile",
      "label": "Padding on mobile",
      "info": "Top right bottom left. Example: 60px 20px 60px 20px. Leave blank to keep the design defaults."
    },
    {
      "type": "header",
      "content": "Section margin"
    },
    {
      "type": "text",
      "id": "nfc_margin_desktop",
      "label": "Margin on desktop",
      "info": "Top right bottom left. Example: 60px 20px 60px 20px. Leave blank to keep the design defaults."
    },
    {
      "type": "text",
      "id": "nfc_margin_mobile",
      "label": "Margin on mobile",
      "info": "Top right bottom left. Example: 60px 20px 60px 20px. Leave blank to keep the design defaults."
    }
  ],
  "presets": [
    {
      "name": "NFC campaign hero"
    }
  ]
}
{% endschema %}
