<section class="content-page page-width customer-page">
  <header class="content-page__heading"><p class="eyebrow">{{ section.settings.eyebrow | escape }}</p><h1>{% case template.name %}{% when 'login' %}WELCOME BACK.{% when 'register' %}JOIN THE COMMUNITY.{% when 'account' %}YOUR ACCOUNT.{% when 'addresses' %}YOUR ADDRESSES.{% when 'order' %}ORDER {{ order.name | escape }}{% when 'reset_password' %}RESET PASSWORD.{% when 'activate_account' %}ACTIVATE ACCOUNT.{% endcase %}</h1></header>
  <div class="content-page__body">
    {% case template.name %}
      {% when 'login' %}
        {% form 'customer_login', class: 'contact-form' %}
          {{ form.errors | default_errors }}
          <label for="CustomerEmail">Email address<input id="CustomerEmail" type="email" name="customer[email]" autocomplete="email" required></label>
          <label for="CustomerPassword">Password<input id="CustomerPassword" type="password" name="customer[password]" autocomplete="current-password" required></label>
          <button class="nfc-button nfc-button--dark" type="submit">Sign in {% render 'nfc-icon', name: 'arrow' %}</button>
          <a href="{{ routes.account_register_url }}">Create an account →</a>
        {% endform %}
        <details class="recover-password" id="recover"><summary>Forgot your password?</summary>
          {% form 'recover_customer_password', class: 'contact-form' %}
            {{ form.errors | default_errors }}
            {% if form.posted_successfully? %}<p role="status">Check your email for a password reset link.</p>{% endif %}
            <label for="RecoverEmail">Email address<input id="RecoverEmail" type="email" name="email" autocomplete="email" required></label>
            <button class="nfc-button nfc-button--dark" type="submit">Send reset link</button>
          {% endform %}
        </details>
        {% if shop.checkout.guest_login %}{% form 'guest_login' %}<button class="nfc-button nfc-button--line" type="submit">Continue as guest</button>{% endform %}{% endif %}
      {% when 'register' %}
        {% form 'create_customer', class: 'contact-form' %}
          {{ form.errors | default_errors }}
          <div class="contact-form__row"><label for="FirstName">First name<input id="FirstName" name="customer[first_name]" value="{{ form.first_name | escape }}" autocomplete="given-name" required></label><label for="LastName">Last name<input id="LastName" name="customer[last_name]" value="{{ form.last_name | escape }}" autocomplete="family-name" required></label></div>
          <label for="RegisterEmail">Email address<input id="RegisterEmail" type="email" name="customer[email]" value="{{ form.email | escape }}" autocomplete="email" required></label>
          <label for="RegisterPassword">Password<input id="RegisterPassword" type="password" name="customer[password]" autocomplete="new-password" required></label>
          <button class="nfc-button nfc-button--dark" type="submit">Create account {% render 'nfc-icon', name: 'arrow' %}</button><a href="{{ routes.account_login_url }}">Already a member? Sign in →</a>
        {% endform %}
      {% when 'reset_password' %}
        {% form 'reset_customer_password', class: 'contact-form' %}{{ form.errors | default_errors }}<label for="ResetPassword">New password<input id="ResetPassword" type="password" name="customer[password]" autocomplete="new-password" required></label><label for="ResetPasswordConfirmation">Confirm password<input id="ResetPasswordConfirmation" type="password" name="customer[password_confirmation]" autocomplete="new-password" required></label><button class="nfc-button nfc-button--dark" type="submit">Reset password</button>{% endform %}
      {% when 'activate_account' %}
        {% form 'activate_customer_password', class: 'contact-form' %}{{ form.errors | default_errors }}<label for="ActivatePassword">Password<input id="ActivatePassword" type="password" name="customer[password]" autocomplete="new-password" required></label><label for="ActivatePasswordConfirmation">Confirm password<input id="ActivatePasswordConfirmation" type="password" name="customer[password_confirmation]" autocomplete="new-password" required></label><button class="nfc-button nfc-button--dark" type="submit">Activate account</button><button class="nfc-button nfc-button--line" type="submit" name="decline">Decline invitation</button>{% endform %}
      {% when 'account' %}
        <div class="account-actions"><p>Hello, {{ customer.first_name | escape }}.</p><a href="{{ routes.account_addresses_url }}">Manage addresses ({{ customer.addresses_count }}) →</a><a href="{{ routes.account_logout_url }}">Sign out</a></div>
        {{ customer.default_address | format_address }}
        <h2>Your orders</h2>
        {% paginate customer.orders by 10 %}<div class="table-scroll"><table><thead><tr><th>Order</th><th>Date</th><th>Payment</th><th>Fulfillment</th><th>Total</th></tr></thead><tbody>{% for order in customer.orders %}<tr><td><a href="{{ order.customer_url }}">{{ order.name | escape }}</a></td><td>{{ order.created_at | date: '%B %d, %Y' }}</td><td>{{ order.financial_status_label }}</td><td>{{ order.fulfillment_status_label }}</td><td>{{ order.total_net_amount | money_with_currency }}</td></tr>{% else %}<tr><td colspan="5">You haven't placed any orders yet.</td></tr>{% endfor %}</tbody></table></div>{% render 'nfc-pagination', paginate: paginate %}{% endpaginate %}
      {% when 'order' %}
        <p>{{ order.created_at | date: '%B %d, %Y' }} / {{ order.financial_status_label }} / {{ order.fulfillment_status_label }}</p>
        {% if order.cancelled %}<p>Cancelled {{ order.cancelled_at | date: '%B %d, %Y' }}: {{ order.cancel_reason_label }}</p>{% endif %}
        <div class="table-scroll"><table><thead><tr><th>Item</th><th>Quantity</th><th>Total</th></tr></thead><tbody>{% for item in order.line_items %}<tr><td>{% if item.url %}<a href="{{ item.url }}">{{ item.title | escape }}</a>{% else %}{{ item.title | escape }}{% endif %}{% for discount in item.line_level_discount_allocations %}<p>{{ discount.discount_application.title | escape }} −{{ discount.amount | money }}</p>{% endfor %}{% if item.fulfillment %}<p>Shipped {{ item.fulfillment.created_at | date: '%B %d, %Y' }}{% if item.fulfillment.tracking_url %} — <a href="{{ item.fulfillment.tracking_url }}">Track shipment {{ item.fulfillment.tracking_number | escape }}</a>{% endif %}</p>{% endif %}</td><td>{{ item.quantity }}</td><td>{{ item.final_line_price | money }}</td></tr>{% endfor %}</tbody></table></div>
        <div class="order-totals"><p>Subtotal: {{ order.line_items_subtotal_price | money }}</p>{% for discount in order.cart_level_discount_applications %}<p>{{ discount.title | escape }}: −{{ discount.total_allocated_amount | money }}</p>{% endfor %}{% for shipping in order.shipping_methods %}<p>{{ shipping.title | escape }}: {{ shipping.price | money }}</p>{% endfor %}{% for tax in order.tax_lines %}<p>{{ tax.title | escape }}: {{ tax.price | money }}</p>{% endfor %}<h3>Total: {{ order.total_net_amount | money_with_currency }}</h3></div>
        <div class="contact-form__row"><div><h3>Billing address</h3>{{ order.billing_address | format_address }}</div><div><h3>Shipping address</h3>{{ order.shipping_address | format_address }}</div></div><a class="nfc-button nfc-button--line" href="{{ routes.account_url }}">← Back to account</a>
      {% when 'addresses' %}
        <a class="nfc-button nfc-button--line" href="{{ routes.account_url }}">← Back to account</a>
        <details class="address-editor"><summary>Add a new address {% render 'nfc-icon', name: 'plus' %}</summary>{% form 'customer_address', customer.new_address, class: 'contact-form' %}{{ form.errors | default_errors }}{% render 'nfc-address-fields', form: form, id: 'New' %}<button class="nfc-button nfc-button--dark" type="submit">Save address</button>{% endform %}</details>
        {% paginate customer.addresses by 6 %}{% for address in customer.addresses %}<div class="address-card">{% if address == customer.default_address %}<p class="eyebrow">Default address</p>{% endif %}{{ address | format_address }}<details class="address-editor"><summary>Edit address {% render 'nfc-icon', name: 'plus' %}</summary>{% form 'customer_address', address, class: 'contact-form' %}{{ form.errors | default_errors }}{% render 'nfc-address-fields', form: form, id: address.id %}<button class="nfc-button nfc-button--dark" type="submit">Update address</button>{% endform %}</details><form method="post" action="{{ routes.account_addresses_url }}/{{ address.id }}"><input type="hidden" name="_method" value="delete"><button class="nfc-button nfc-button--text" type="submit">Delete address</button></form></div>{% endfor %}{% render 'nfc-pagination', paginate: paginate %}{% endpaginate %}
    {% endcase %}
  </div>
</section>
{% schema %}
{"name":"NFC customer account","settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"FAITH IN EVERY FIT"}]}
{% endschema %}
