<!-- Swiper JS Initialization Logic -->
<script>
  window.addEventListener('DOMContentLoaded', function() {
    if (typeof Swiper !== 'undefined') {
      var isDesktopSlider = "{{ section.settings.desktop_layout }}" === "slider";
      var isMobileSlider = "{{ section.settings.mobile_layout }}" === "slider";

      if (isDesktopSlider || isMobileSlider) {
        new Swiper('.fcs-swiper-{{ section.id }}', {
          slidesPerView: {{ section.settings.mobile_columns }},
          spaceBetween: 12,
          loop: {{ section.settings.enable_loop }},
          autoplay: {% if section.settings.enable_autoplay %}{ delay: {{ section.settings.autoplay_speed | times: 1000 }} }{% else %}false{% endif %},
          navigation: {
            nextEl: '.fcs-btn-next-{{ section.id }}',
            prevEl: '.fcs-btn-prev-{{ section.id }}',
          },
          pagination: {
            el: '.fcs-pagination-{{ section.id }}',
            clickable: true,
          },
          breakpoints: {
            769: {
              slidesPerView: {{ section.settings.desktop_columns }},
              spaceBetween: 24
            }
          }
        });
      }
    }
  });
</script>

