    .fcs-section-{{ section.id }} .fcs-nav-btn {
      width: 36px !important;
      height: 36px !important;
    }

    .fcs-section-{{ section.id }} .fcs-pure-grid {
      grid-template-columns: repeat({{ section.settings.mobile_columns }}, 1fr) !important;
      gap: 12px !important;
    }

    .fcs-section-{{ section.id }} .fcs-card {
      padding: 10px !important;
    }

    .fcs-section-{{ section.id }} .fcs-badges-container {
      top: 8px !important;
      left: 8px !important;
      gap: 4px !important;
    }

    .fcs-section-{{ section.id }} .fcs-badge {
      font-size: 7.5px !important;
      letter-spacing: 1px !important;
      padding: 3px 6px !important;
    }

    .fcs-section-{{ section.id }} .fcs-product-info {
      padding: 12px 2px 4px 2px !important;
    }

    .fcs-section-{{ section.id }} .fcs-title-price-row {
      flex-direction: column !important;
      align-items: flex-start !important;
      gap: 4px !important;
    }

    .fcs-section-{{ section.id }} .fcs-product-title {
      font-size: 14.5px !important;
      line-height: 1.25 !important;
    }

    .fcs-section-{{ section.id }} .fcs-product-price {
      font-size: 13.5px !important;
    }

    .fcs-section-{{ section.id }} .fcs-short-desc {
      font-size: 11.5px !important;
      line-height: 1.4 !important;
      margin-top: 4px !important;
      display: -webkit-box;
      -webkit-line-clamp: 2;
      -webkit-box-orient: vertical;
      overflow: hidden;
    }
  }

  @media screen and (max-width: 480px) {
    .fcs-section-{{ section.id }} .fcs-title {
      font-size: 21px !important;
    }

    .fcs-section-{{ section.id }} .fcs-nav-btn {
      width: 34px !important;
      height: 34px !important;
    }

    .fcs-section-{{ section.id }} .fcs-nav-btn svg {
      width: 15px !important;
      height: 15px !important;
    }
  }

  {% comment %} custom code start {% endcomment %}
   /* Keep product cards the same height */
.fcs-section-{{ section.id }} .swiper-slide {
  display: flex;
}

.fcs-section-{{ section.id }} .fcs-card {
  flex: 1 1 auto;
}

.fcs-section-{{ section.id }} .fcs-product-info {
  flex: 1 1 auto;
}

.fcs-section-{{ section.id }} .fcs-pure-grid-item {
