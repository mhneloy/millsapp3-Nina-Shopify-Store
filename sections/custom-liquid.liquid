{% comment %}
  Custom Liquid Section
  Allows inserting raw Liquid code, HTML, or scripts directly from Theme Editor.
{% endcomment %}

{%- style -%}
  .custom-liquid-{{ section.id }} {
    width: 100%;
    background-color: transparent;
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }

  .custom-liquid-{{ section.id }} .custom-liquid-wrapper {
    width: 100%;
    margin: 0 auto;
    {% if section.settings.width_type == 'custom' %}
      max-width: {{ section.settings.custom_width }}px;
    {% else %}
      max-width: 100%;
    {% endif %}
  }
{%- endstyle -%}

<div class="custom-liquid-{{ section.id }}">
  <div class="custom-liquid-wrapper">
    {%- if section.settings.custom_liquid != blank -%}
      {{ section.settings.custom_liquid }}
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Custom Liquid Code",
  "tag": "section",
  "class": "section-custom-liquid",
  "settings": [
    {
      "type": "liquid",
      "id": "custom_liquid",
      "label": "Custom Liquid",
      "info": "Apnar Liquid ba HTML code ekhane paste korun."
    },
    {
      "type": "header",
      "content": "Container Width"
    },
    {
      "type": "select",
      "id": "width_type",
      "label": "Width Type",
      "options": [
        { "value": "full", "label": "Full Width (100%)" },
        { "value": "custom", "label": "Custom Max Width (px)" }
      ],
      "default": "full"
    },
    {
      "type": "range",
      "id": "custom_width",
      "min": 600,
      "max": 1920,
      "step": 20,
      "unit": "px",
      "label": "Custom Max Width",
      "default": 1200
    },
    {
      "type": "header",
      "content": "Section Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top Padding",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom Padding",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "Custom Liquid Code"
    }
  ]
}
{% endschema %}