{% render 'nfc-section-style', section: section %}
{% if section.settings.announcement != blank %}<div class="announcement-bar"><span>{{ section.settings.announcement | escape }}</span><span class="announcement-bar__separator" aria-hidden="true">✳</span><a href="{{ section.settings.announcement_link | default: routes.all_products_collection_url }}">{{ section.settings.announcement_cta | escape }} {% render 'nfc-icon', name: 'arrow' %}</a></div>{% endif %}
<header class="site-header"><div class="site-header__inner page-width">
<button class="nfc-button nfc-button--icon mobile-menu-button" data-open-dialog="NfcNavigation" aria-label="Open navigation" aria-haspopup="dialog">{% render 'nfc-icon', name: 'menu' %}</button>
<a class="wordmark" href="{{ routes.root_url }}" aria-label="{{ shop.name | escape }} home">{% if section.settings.logo != blank %}{{ section.settings.logo | image_url: width: 400 | image_tag: widths: '100, 200, 400', class: 'brand-logo', alt: shop.name }}{% else %}<span>{{ section.settings.brand_top | escape }}</span><span>{{ section.settings.brand_bottom | escape }}</span><small>{{ section.settings.tagline | escape }}</small>{% endif %}</a>
<nav class="desktop-nav" aria-label="Main navigation">{% render 'nfc-menu', menu: section.settings.menu %}</nav>
<div class="header-actions"><a class="nfc-button nfc-button--icon" href="{{ routes.all_products_collection_url }}" data-search-open aria-haspopup="dialog" aria-controls="NfcSearch" aria-label="Search products">{% render 'nfc-icon', name: 'search' %}</a>{% if shop.customer_accounts_enabled %}<a class="account-link" href="{{ routes.account_url }}">Account</a>{% endif %}<a class="nfc-button nfc-button--icon cart-trigger" href="{{ routes.cart_url }}" data-cart-open aria-label="Shopping bag"><span class="sr-only">Shopping bag</span>{% render 'nfc-icon', name: 'bag' %}<span class="cart-trigger__count" data-cart-count>{{ cart.item_count }}</span></a></div></div></header>
<dialog id="NfcNavigation" class="nfc-dialog mobile-nav-sheet"><div class="dialog-heading"><span class="eyebrow">Navigation</span><button class="nfc-button nfc-button--icon" data-close-dialog aria-label="Close navigation">{% render 'nfc-icon', name: 'close' %}</button></div><nav class="mobile-nav-links" aria-label="Mobile navigation">{% render 'nfc-menu', menu: section.settings.menu %}</nav></dialog>
{% schema %}
{
  "name": "NFC header",
  "settings": [
    {
      "type": "text",
      "id": "announcement",
      "label": "Announcement",
      "default": "FAITH-INSPIRED STREETWEAR"
    },
    {
      "type": "text",
      "id": "announcement_cta",
      "label": "Announcement link label",
      "default": "Explore the collection"
    },
    {
      "type": "url",
      "id": "announcement_link",
      "label": "Announcement link"
    },
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo"
    },
    {
      "type": "text",
      "id": "brand_top",
      "label": "Wordmark first line",
      "default": "NUTS"
    },
    {
      "type": "text",
      "id": "brand_bottom",
      "label": "Wordmark second line",
      "default": "FOR CHRIST"
    },
    {
      "type": "text",
      "id": "tagline",
      "label": "Tagline",
      "default": "FAITH IN EVERY FIT"
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Navigation menu"
    },
    {
      "type": "header",
      "content": "Section colors"
    },
    {
      "type": "paragraph",
      "content": "Leave a color empty to keep the original design. These controls affect only this section."
    },
    {
      "type": "color",
      "id": "nfc_background_color",
      "label": "Background"
    },
    {
      "type": "color",
      "id": "nfc_heading_color",
      "label": "Headings"
    },
    {
      "type": "color",
      "id": "nfc_text_color",
      "label": "Paragraphs and body text"
    },
    {
      "type": "color",
      "id": "nfc_eyebrow_color",
      "label": "Eyebrow text"
    },
    {
      "type": "color",
      "id": "nfc_link_color",
      "label": "Links"
    },
    {
      "type": "color",
      "id": "nfc_accent_color",
      "label": "Accents"
    },
    {
      "type": "color",
      "id": "nfc_border_color",
      "label": "Borders and dividers"
    },
    {
      "type": "header",
      "content": "Section buttons"
    },
    {
      "type": "color",
      "id": "nfc_button_text",
      "label": "Button text and icons"
    },
    {
      "type": "color",
      "id": "nfc_button_background",
      "label": "Filled button background"
    },
    {
      "type": "color",
      "id": "nfc_button_border",
      "label": "Button border"
    },
    {
      "type": "color",
      "id": "nfc_button_hover_text",
      "label": "Button hover text"
    },
    {
      "type": "color",
      "id": "nfc_button_hover_background",
      "label": "Filled button hover background"
    },
    {
      "type": "header",
      "content": "Section layout"
    },
    {
      "type": "select",
      "id": "nfc_content_position",
      "label": "Content column position",
      "default": "default",
      "options": [
        {
          "value": "default",
          "label": "Original design"
        },
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ]
    },
    {
      "type": "select",
      "id": "nfc_text_alignment",
      "label": "Heading alignment",
      "default": "default",
      "options": [
        {
          "value": "default",
          "label": "Original design"
        },
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ]
    },
    {
      "type": "checkbox",
      "id": "nfc_custom_width",
      "label": "Customize content width",
      "default": false
    },
    {
      "type": "range",
      "id": "nfc_content_width",
      "label": "Content width",
      "min": 480,
      "max": 1600,
      "step": 20,
      "default": 1440,
      "unit": "px"
    },
    {
      "type": "header",
      "content": "Section typography"
    },
    {
      "type": "checkbox",
      "id": "nfc_custom_typography",
      "label": "Customize text sizes",
      "default": false
    },
    {
      "type": "range",
      "id": "nfc_heading_size",
      "label": "Heading size on desktop",
      "min": 20,
      "max": 140,
      "step": 2,
      "default": 56,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "nfc_heading_size_mobile",
      "label": "Heading size on mobile",
      "min": 20,
      "max": 100,
      "step": 2,
      "default": 36,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "nfc_paragraph_size",
      "label": "Paragraph size on desktop",
      "min": 10,
      "max": 30,
      "step": 1,
      "default": 14,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "nfc_paragraph_size_mobile",
      "label": "Paragraph size on mobile",
      "min": 10,
      "max": 30,
      "step": 1,
      "default": 14,
      "unit": "px"
    },
    {
      "type": "header",
      "content": "Section padding"
    },
    {
      "type": "text",
      "id": "nfc_padding_desktop",
      "label": "Padding on desktop",
      "info": "Top right bottom left. Example: 60px 20px 60px 20px. Leave blank to keep the design defaults."
    },
    {
      "type": "text",
      "id": "nfc_padding_mobile",
      "label": "Padding on mobile",
      "info": "Top right bottom left. Example: 60px 20px 60px 20px. Leave blank to keep the design defaults."
    },
    {
      "type": "header",
      "content": "Section margin"
    },
    {
      "type": "text",
      "id": "nfc_margin_desktop",
      "label": "Margin on desktop",
      "info": "Top right bottom left. Example: 60px 20px 60px 20px. Leave blank to keep the design defaults."
    },
    {
      "type": "text",
      "id": "nfc_margin_mobile",
      "label": "Margin on mobile",
      "info": "Top right bottom left. Example: 60px 20px 60px 20px. Leave blank to keep the design defaults."
    }
  ]
}
{% endschema %}
