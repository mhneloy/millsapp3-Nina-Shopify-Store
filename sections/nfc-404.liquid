<section class="content-page page-width"><header class="content-page__heading"><p class="eyebrow">404 / PAGE NOT FOUND</p><h1>{{ section.settings.heading | escape }}</h1><p>{{ section.settings.copy | escape }}</p></header><div class="content-page__body"><a class="nfc-button nfc-button--dark" href="{{ routes.all_products_collection_url }}">Explore the collection {% render 'nfc-icon', name: 'arrow' %}</a></div></section>
{% schema %}
{
  "name": "NFC 404",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "LOST YOUR WAY?"
    },
    {
      "type": "text",
      "id": "copy",
      "label": "Description",
      "default": "Let's find your next statement."
    }
  ]
}
{% endschema %}
