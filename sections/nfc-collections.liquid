<section class="content-page page-width"><header class="content-page__heading"><p class="eyebrow">{{ section.settings.eyebrow | escape }}</p><h1>{{ section.settings.heading | escape }}</h1></header>{% paginate collections by 12 %}<div class="category-grid">{% for collection in collections %}<a href="{{ collection.url }}" class="category-tile">{% if collection.featured_image %}{{ collection.featured_image | image_url: width: 1100 | image_tag: loading: 'lazy', alt: collection.title }}{% endif %}<span class="category-tile__number">{{ collection.all_products_count }} pieces</span><span class="category-tile__bottom">{{ collection.title | escape }} {% render 'nfc-icon', name: 'arrow' %}</span></a>{% endfor %}</div>{% render 'nfc-pagination', paginate: paginate %}{% endpaginate %}</section>
{% schema %}
{
  "name": "NFC collections",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "THE COLLECTION"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "FIND YOUR FIT"
    }
  ]
}
{% endschema %}
