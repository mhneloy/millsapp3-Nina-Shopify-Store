{% comment %}
  Custom Header Banner Section
  Features: No image cropping (contain fit), Full Width & Custom Width, Desktop/Mobile Height, Mobile Toggle, Transparent Background
{% endcomment %}

{%- style -%}
  .header-banner-{{ section.id }} {
    width: 100%;
    background-color: transparent;
    display: flex;
    justify-content: center;
    align-items: center;
    overflow: hidden;
  }

  .header-banner-{{ section.id }} .banner-container {
    width: 100%;
    position: relative;
    display: flex;
    justify-content: center;
    align-items: center;
    {% if section.settings.width_type == 'custom' %}
      max-width: {{ section.settings.custom_width }}px;
    {% else %}
      max-width: 100%;
    {% endif %}
  }

  /* Image styling to ensure NO CROPPING */
  .header-banner-{{ section.id }} .banner-image {
    width: 100%;
    height: {{ section.settings.desktop_height }}px;
    object-fit: {{ section.settings.image_fit }};
    object-position: center;
    display: block;
  }

  /* Desktop & Mobile Image Toggle Logic */
  .header-banner-{{ section.id }} .img-desktop {
    display: block;
  }
  .header-banner-{{ section.id }} .img-mobile {
    display: none;
  }

  @media screen and (max-width: 749px) {
    {% unless section.settings.show_on_mobile %}
      .header-banner-{{ section.id }} {
        display: none !important;
      }
    {% endunless %}

    .header-banner-{{ section.id }} .banner-image {
      height: {{ section.settings.mobile_height }}px;
    }

    {% if section.settings.image_mobile != blank %}
      .header-banner-{{ section.id }} .img-desktop {
        display: none;
      }
      .header-banner-{{ section.id }} .img-mobile {
        display: block;
      }
    {% endif %}
  }
{%- endstyle -%}

<div class="header-banner-{{ section.id }}">
  <div class="banner-container">
    {%- if section.settings.image_desktop != blank -%}
      {%- comment -%} Desktop Image {%- endcomment -%}
      <img
        src="{{ section.settings.image_desktop | image_url: width: 2000 }}"
        alt="{{ section.settings.image_desktop.alt | escape }}"
        class="banner-image img-desktop"
        loading="eager"
        width="{{ section.settings.image_desktop.width }}"
        height="{{ section.settings.image_desktop.height }}"
      >

      {%- comment -%} Mobile Image (If present) {%- endcomment -%}
      {%- if section.settings.image_mobile != blank -%}
        <img
          src="{{ section.settings.image_mobile | image_url: width: 1000 }}"
          alt="{{ section.settings.image_mobile.alt | escape }}"
          class="banner-image img-mobile"
          loading="eager"
          width="{{ section.settings.image_mobile.width }}"
          height="{{ section.settings.image_mobile.height }}"
        >
      {%- endif -%}
    {%- else -%}
      {{ 'lifestyle-1' | placeholder_svg_tag: 'banner-image' }}
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Header Banner",
  "tag": "section",
  "class": "section-header-banner",
  "settings": [
    {
      "type": "header",
      "content": "Image Settings"
    },
    {
      "type": "image_picker",
      "id": "image_desktop",
      "label": "Desktop Image"
    },
    {
      "type": "image_picker",
      "id": "image_mobile",
      "label": "Mobile Image (Optional)",
      "info": "মোবাইল ইমেজ না দিলে বাই-ডিফল্ট ডেস্কটপ ইমেজ পাবে।"
    },
    {
      "type": "select",
      "id": "image_fit",
      "label": "Image Display Style",
      "options": [
        { "value": "contain", "label": "Contain (No Crop / সম্পূর্ণ ইমেজ দেখাবে)" },
        { "value": "cover", "label": "Cover (Crop to fill entire space)" },
        { "value": "fill", "label": "Stretch to fill width & height" }
      ],
      "default": "contain",
      "info": "'Contain' সিলেক্ট করা থাকলে আপনার দেয়া হাইট ও উইথের ভেতরে পুরো ইমেজটি কাটা ছাড়া দেখা যাবে।"
    },
    {
      "type": "header",
      "content": "Visibility Settings"
    },
    {
      "type": "checkbox",
      "id": "show_on_mobile",
      "label": "Show Banner on Mobile",
      "default": true
    },
    {
      "type": "header",
      "content": "Width Control"
    },
    {
      "type": "select",
      "id": "width_type",
      "label": "Container Width",
      "options": [
        { "value": "full", "label": "Full Width (100%)" },
        { "value": "custom", "label": "Custom Width (px)" }
      ],
      "default": "full"
    },
    {
      "type": "range",
      "id": "custom_width",
      "min": 600,
      "max": 1920,
      "step": 20,
      "unit": "px",
      "label": "Custom Max Width",
      "default": 1200
    },
    {
      "type": "header",
      "content": "Height Control"
    },
    {
      "type": "range",
      "id": "desktop_height",
      "min": 80,
      "max": 1000,
      "step": 10,
      "unit": "px",
      "label": "Desktop Height",
      "default": 250
    },
    {
      "type": "range",
      "id": "mobile_height",
      "min": 50,
      "max": 800,
      "step": 10,
      "unit": "px",
      "label": "Mobile Height",
      "default": 120
    }
  ],
  "presets": [
    {
      "name": "Header Banner"
    }
  ]
}
{% endschema %}