{% render 'nfc-section-style', section: section %}
<section class="brand-statement"><div class="brand-statement__inner page-width"><p class="eyebrow">{{ section.settings.eyebrow | escape }}</p><h2>{{ section.settings.heading | escape | newline_to_br }}<br><span>{{ section.settings.accent_heading | escape }}</span></h2><div class="statement-copy">{{ section.settings.copy }}</div><a class="hero-text-link" href="{{ section.settings.link | default: routes.all_products_collection_url }}">{{ section.settings.button_label | escape }} {% render 'nfc-icon', name: 'arrow' %}</a></div><span class="brand-statement__mark" aria-hidden="true">{{ section.settings.watermark | escape }}</span></section>
{% schema %}
{
  "name": "NFC brand statement",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "A DIFFERENT KIND OF STATEMENT"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "MORE THAN CLOTHING."
    },
    {
      "type": "text",
      "id": "accent_heading",
      "label": "Accent heading",
      "default": "A STATEMENT OF FAITH."
    },
    {
      "type": "richtext",
      "id": "copy",
      "label": "Description",
      "default": "<p>Nuts for Christ brings bold expression and faith-inspired style together through everyday streetwear.</p>"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Link label",
      "default": "Explore the collection"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Link"
    },
    {
      "type": "text",
      "id": "watermark",
      "label": "Watermark",
      "default": "NFC"
    },
    {
      "type": "header",
      "content": "Section colors"
    },
    {
      "type": "paragraph",
      "content": "Leave a color empty to keep the original design. These controls affect only this section."
    },
    {
      "type": "color",
      "id": "nfc_background_color",
      "label": "Background"
    },
    {
      "type": "color",
      "id": "nfc_heading_color",
      "label": "Headings"
    },
    {
      "type": "color",
      "id": "nfc_text_color",
      "label": "Paragraphs and body text"
    },
    {
      "type": "color",
      "id": "nfc_eyebrow_color",
      "label": "Eyebrow text"
    },
    {
      "type": "color",
      "id": "nfc_link_color",
      "label": "Links"
    },
    {
      "type": "color",
      "id": "nfc_accent_color",
      "label": "Accents"
    },
    {
      "type": "color",
      "id": "nfc_border_color",
      "label": "Borders and dividers"
    },
    {
      "type": "header",
      "content": "Section buttons"
    },
    {
      "type": "color",
      "id": "nfc_button_text",
      "label": "Button text and icons"
    },
    {
      "type": "color",
      "id": "nfc_button_background",
      "label": "Filled button background"
    },
    {
      "type": "color",
      "id": "nfc_button_border",
      "label": "Button border"
    },
    {
      "type": "color",
      "id": "nfc_button_hover_text",
      "label": "Button hover text"
    },
    {
      "type": "color",
      "id": "nfc_button_hover_background",
      "label": "Filled button hover background"
    },
    {
      "type": "header",
      "content": "Section layout"
    },
    {
      "type": "select",
      "id": "nfc_content_position",
      "label": "Content column position",
      "default": "default",
      "options": [
        {
          "value": "default",
          "label": "Original design"
        },
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ]
    },
    {
      "type": "select",
      "id": "nfc_text_alignment",
      "label": "Heading alignment",
      "default": "default",
      "options": [
        {
          "value": "default",
          "label": "Original design"
        },
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ]
    },
    {
      "type": "checkbox",
      "id": "nfc_custom_width",
      "label": "Customize content width",
      "default": false
    },
    {
      "type": "range",
      "id": "nfc_content_width",
      "label": "Content width",
      "min": 480,
      "max": 1600,
      "step": 20,
      "default": 1440,
      "unit": "px"
    },
    {
      "type": "header",
      "content": "Section typography"
    },
    {
      "type": "checkbox",
      "id": "nfc_custom_typography",
      "label": "Customize text sizes",
      "default": false
    },
    {
      "type": "range",
      "id": "nfc_heading_size",
      "label": "Heading size on desktop",
      "min": 20,
      "max": 140,
      "step": 2,
      "default": 56,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "nfc_heading_size_mobile",
      "label": "Heading size on mobile",
      "min": 20,
      "max": 100,
      "step": 2,
      "default": 36,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "nfc_paragraph_size",
      "label": "Paragraph size on desktop",
      "min": 10,
      "max": 30,
      "step": 1,
      "default": 14,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "nfc_paragraph_size_mobile",
      "label": "Paragraph size on mobile",
      "min": 10,
      "max": 30,
      "step": 1,
      "default": 14,
      "unit": "px"
    },
    {
      "type": "header",
      "content": "Section padding"
    },
    {
      "type": "text",
      "id": "nfc_padding_desktop",
      "label": "Padding on desktop",
      "info": "Top right bottom left. Example: 60px 20px 60px 20px. Leave blank to keep the design defaults."
    },
    {
      "type": "text",
      "id": "nfc_padding_mobile",
      "label": "Padding on mobile",
      "info": "Top right bottom left. Example: 60px 20px 60px 20px. Leave blank to keep the design defaults."
    },
    {
      "type": "header",
      "content": "Section margin"
    },
    {
      "type": "text",
      "id": "nfc_margin_desktop",
      "label": "Margin on desktop",
      "info": "Top right bottom left. Example: 60px 20px 60px 20px. Leave blank to keep the design defaults."
    },
    {
      "type": "text",
      "id": "nfc_margin_mobile",
      "label": "Margin on mobile",
      "info": "Top right bottom left. Example: 60px 20px 60px 20px. Leave blank to keep the design defaults."
    }
  ],
  "presets": [
    {
      "name": "NFC brand statement"
    }
  ]
}
{% endschema %}
