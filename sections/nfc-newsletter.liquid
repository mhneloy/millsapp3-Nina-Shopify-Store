<section class="newsletter-band page-width"><div><p class="eyebrow">{{ section.settings.eyebrow | escape }}</p><h2>{{ section.settings.heading | escape }}</h2><p>{{ section.settings.copy | escape }}</p></div>{% render 'nfc-newsletter', id: section.id, label: section.settings.button_label %}</section>
{% schema %}
{
  "name": "NFC newsletter",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "THE NEXT DROP, IN YOUR INBOX"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "STAY CONNECTED."
    },
    {
      "type": "text",
      "id": "copy",
      "label": "Description",
      "default": "Get updates on new drops and the latest from Nuts for Christ."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Subscribe"
    }
  ],
  "presets": [
    {
      "name": "NFC newsletter"
    }
  ]
}
{% endschema %}
