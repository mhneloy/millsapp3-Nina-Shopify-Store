{% render 'nfc-section-style', section: section %}
{%- assign breadcrumb_home_label = section.settings.eyebrow | strip -%}
{%- if breadcrumb_home_label == 'NUTS FOR CHRIST / COLLECTION 001' -%}
  {%- assign breadcrumb_home_label = 'NUTS FOR CHRIST' -%}
{%- endif -%}
{% liquid
  assign columns_desktop = section.settings.columns_desktop | default: 4
  assign columns_mobile = section.settings.columns_mobile | default: 2
  assign image_width_desktop = 100.0 | divided_by: columns_desktop | round: 2
  assign image_width_mobile = 100.0 | divided_by: columns_mobile | round: 2
%}
{% capture card_image_sizes %}(max-width: 1024px) {{ image_width_mobile }}vw, {{ image_width_desktop }}vw{% endcapture %}

{% style %}
  #shopify-section-{{ section.id }} [data-catalog-results] .product-grid {
    grid-template-columns: repeat({{ columns_desktop }}, minmax(0, 1fr));
    {% if section.settings.card_image_ratio != blank and section.settings.card_image_ratio != 'default' %}
      --card-image-ratio: {{ section.settings.card_image_ratio }};
    {% endif %}
  }

  @media (max-width: 1024px) {
    #shopify-section-{{ section.id }} [data-catalog-results] .product-grid {
      grid-template-columns: repeat({{ columns_mobile }}, minmax(0, 1fr));
    }
  }
{% endstyle %}

<section class="shop-page page-width" data-catalog-section data-section-id="{{ section.id }}" data-collection-url="{{ collection.url }}" data-collection-handle="{{ collection.handle | escape }}">
  <header class="shop-heading">
    <nav class="eyebrow" aria-label="Breadcrumb">
      {%- if breadcrumb_home_label != blank -%}
        <a href="{{ routes.root_url }}">{{ breadcrumb_home_label | escape }}</a>
        <span aria-hidden="true"> / </span>
      {%- endif -%}
      <span aria-current="page">{{ collection.title | escape }}</span>
    </nav>
    <h1>{{ section.settings.heading | default: collection.title | escape }}</h1>
    <div class="rte">{{ collection.description }}</div>
  </header>
{% paginate collection.products by section.settings.per_page %}
<div class="shop-toolbar"><span class="shop-toolbar__count" data-catalog-count>{{ collection.products_count }} pieces</span><form class="shop-search" data-catalog-search role="search" action="{{ collection.url }}" method="get"><label class="sr-only" for="CollectionSearch-{{ section.id }}">Search catalog</label><input id="CollectionSearch-{{ section.id }}" name="q" type="search" placeholder="Search catalog"><button class="nfc-button nfc-button--icon" aria-label="Search">{% render 'nfc-icon', name: 'search' %}</button></form>
<form method="get" action="{{ collection.url }}" class="shop-toolbar__filters" data-filter-form>
{% if section.settings.show_filters %}{% for filter in collection.filters %}<details class="filter-dropdown"><summary>{{ filter.label | escape }}{% if filter.active_values.size > 0 %} ({{ filter.active_values.size }}){% endif %}</summary><div class="filter-panel">{% case filter.type %}{% when 'list', 'boolean' %}{% for value in filter.values %}<label><input type="checkbox" name="{{ value.param_name }}" value="{{ value.value | escape }}" {% if value.active %}checked{% elsif value.count == 0 %}disabled{% endif %}> {{ value.label | escape }} ({{ value.count }})</label>{% endfor %}{% when 'price_range' %}<label>Min {{ cart.currency.symbol }}<input type="number" name="{{ filter.min_value.param_name }}" min="0" step="0.01" placeholder="0" {% if filter.min_value.value %}value="{{ filter.min_value.value | divided_by: 100.0 }}"{% endif %}></label><label>Max {{ cart.currency.symbol }}<input type="number" name="{{ filter.max_value.param_name }}" min="0" step="0.01" placeholder="{{ filter.range_max | divided_by: 100.0 }}" {% if filter.max_value.value %}value="{{ filter.max_value.value | divided_by: 100.0 }}"{% endif %}></label>{% endcase %}</div></details>{% endfor %}{% endif %}
<label class="sr-only" for="Sort-{{ section.id }}">Sort products</label><select name="sort_by" id="Sort-{{ section.id }}">{% assign sort_by = collection.sort_by | default: collection.default_sort_by %}{% for option in collection.sort_options %}<option value="{{ option.value }}" {% if option.value == sort_by %}selected{% endif %}>{{ option.name | escape }}</option>{% endfor %}</select><button class="nfc-button nfc-button--text" type="submit">Apply</button></form></div>
<div class="active-filter-row">{% for filter in collection.filters %}{% for value in filter.active_values %}<a href="{{ value.url_to_remove }}">{{ value.label | escape }} ×</a>{% endfor %}{% if filter.type == 'price_range' %}{% if filter.min_value.value != nil or filter.max_value.value != nil %}<a href="{{ filter.url_to_remove }}">{{ filter.label | escape }} ×</a>{% endif %}{% endif %}{% endfor %}<a href="{{ collection.url }}">Clear filters</a></div>
<p class="form-note" data-catalog-status role="status"></p>
<div data-catalog-results>
  {% if collection.products.size > 0 %}
    <div class="product-grid">
      {% for product in collection.products %}
        {% render 'nfc-product-card', product: product, product_collection: collection, image_sizes: card_image_sizes %}
      {% endfor %}
    </div>
  {% else %}
    {% render 'nfc-empty' %}
  {% endif %}
  {% render 'nfc-pagination', paginate: paginate %}
</div>
{% endpaginate %}
</section>
{% schema %}
{
  "name": "NFC collection",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Breadcrumb home label",
      "default": "NUTS FOR CHRIST"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading override"
    },
    {
      "type": "header",
      "content": "Product grid"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "label": "Cards per row on desktop",
      "min": 1,
      "max": 6,
      "step": 1,
      "default": 4
    },
    {
      "type": "range",
      "id": "columns_mobile",
      "label": "Cards per row on mobile and tablet",
      "min": 1,
      "max": 3,
      "step": 1,
      "default": 2
    },
    {
      "type": "select",
      "id": "card_image_ratio",
      "label": "Card image ratio",
      "default": "default",
      "options": [
        { "value": "default", "label": "Theme default" },
        { "value": "1/1", "label": "1:1 Square" },
        { "value": "3/4", "label": "3:4 Portrait" },
        { "value": "4/5", "label": "4:5 Portrait" },
        { "value": "4/3", "label": "4:3 Landscape" },
        { "value": "16/9", "label": "16:9 Wide" }
      ]
    },
    {
      "type": "range",
      "id": "per_page",
      "label": "Products per page",
      "min": 8,
      "max": 48,
      "step": 1,
      "default": 16
    },
    {
      "type": "checkbox",
      "id": "show_filters",
      "label": "Show Shopify filters",
      "default": true
    },
    {
      "type": "header",
      "content": "Section colors"
    },
    {
      "type": "paragraph",
      "content": "Leave a color empty to keep the original design. These controls affect only this section."
    },
    {
      "type": "color",
      "id": "nfc_background_color",
      "label": "Background"
    },
    {
      "type": "color",
      "id": "nfc_heading_color",
      "label": "Headings"
    },
    {
      "type": "color",
      "id": "nfc_text_color",
      "label": "Paragraphs and body text"
    },
    {
      "type": "color",
      "id": "nfc_eyebrow_color",
      "label": "Eyebrow text"
    },
    {
      "type": "color",
      "id": "nfc_link_color",
      "label": "Links"
    },
    {
      "type": "color",
      "id": "nfc_accent_color",
      "label": "Accents"
    },
    {
      "type": "color",
      "id": "nfc_border_color",
      "label": "Borders and dividers"
    },
    {
      "type": "header",
      "content": "Section buttons"
    },
    {
      "type": "color",
      "id": "nfc_button_text",
      "label": "Button text and icons"
    },
    {
      "type": "color",
      "id": "nfc_button_background",
      "label": "Filled button background"
    },
    {
      "type": "color",
      "id": "nfc_button_border",
      "label": "Button border"
    },
    {
      "type": "color",
      "id": "nfc_button_hover_text",
      "label": "Button hover text"
    },
    {
      "type": "color",
      "id": "nfc_button_hover_background",
      "label": "Filled button hover background"
    },
    {
      "type": "header",
      "content": "Section layout"
    },
    {
      "type": "select",
