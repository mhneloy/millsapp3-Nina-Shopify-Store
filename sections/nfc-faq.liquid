<section class="content-page page-width"><header class="content-page__heading"><p class="eyebrow">{{ section.settings.eyebrow | escape }}</p><h1>{{ section.settings.heading | default: page.title | escape }}</h1>{% if section.settings.copy != blank %}<p>{{ section.settings.copy | escape }}</p>{% endif %}</header><div class="content-page__body"><div class="faq-accordion">{% assign previous_group = '' %}{% for block in section.blocks %}<div class="faq-group" {{ block.shopify_attributes }}>{% if block.settings.group != previous_group %}<p class="eyebrow">{{ block.settings.group | escape }}</p>{% assign previous_group = block.settings.group %}{% endif %}<details><summary>{{ block.settings.question | escape }} {% render 'nfc-icon', name: 'plus' %}</summary><div class="rte">{{ block.settings.answer }}{% if block.settings.page != blank %}{{ block.settings.page.content }}{% endif %}</div></details></div>{% endfor %}</div><div class="faq-contact"><div><p class="eyebrow">{{ section.settings.contact_eyebrow | escape }}</p><h2>{{ section.settings.contact_heading | escape }}</h2></div><a class="nfc-button nfc-button--dark" href="{{ section.settings.contact_link | default: '/pages/contact' }}">{{ section.settings.contact_label | escape }} {% render 'nfc-icon', name: 'arrow' %}</a></div></div></section>
{% schema %}
{
  "name": "NFC faq",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "HERE TO HELP"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "FREQUENTLY ASKED QUESTIONS"
    },
    {
      "type": "text",
      "id": "copy",
      "label": "Description",
      "default": "Find answers to common questions about shopping with Nuts for Christ."
    },
    {
      "type": "text",
      "id": "contact_eyebrow",
      "label": "Contact eyebrow",
      "default": "WE'RE HERE TO HELP"
    },
    {
      "type": "text",
      "id": "contact_heading",
      "label": "Contact heading",
      "default": "Still have questions?"
    },
    {
      "type": "text",
      "id": "contact_label",
      "label": "Contact button",
      "default": "Contact us"
    },
    {
      "type": "url",
      "id": "contact_link",
      "label": "Contact link"
    }
  ],
  "blocks": [
    {
      "type": "question",
      "name": "Question",
      "settings": [
        {
          "type": "text",
          "id": "group",
          "label": "Group heading",
          "default": "01 / ORDERS & PAYMENTS"
        },
        {
          "type": "text",
          "id": "question",
          "label": "Question",
          "default": "How can I track my order?"
        },
        {
          "type": "richtext",
          "id": "answer",
          "label": "Answer"
        },
        {
          "type": "page",
          "id": "page",
          "label": "Answer from page"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "NFC faq",
      "blocks": [
        {
          "type": "question"
        }
      ]
    }
  ]
}
{% endschema %}
