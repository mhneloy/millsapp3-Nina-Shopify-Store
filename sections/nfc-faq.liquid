{% render 'nfc-section-style', section: section %}
<section class="content-page page-width"><header class="content-page__heading"><p class="eyebrow">{{ section.settings.eyebrow | escape }}</p><h1>{{ section.settings.heading | default: page.title | escape }}</h1>{% if section.settings.copy != blank %}<p>{{ section.settings.copy | escape }}</p>{% endif %}</header><div class="content-page__body"><div class="faq-accordion">{% assign previous_group = '' %}{% for block in section.blocks %}<div class="faq-group" {{ block.shopify_attributes }}>{% if block.settings.group != previous_group %}<p class="eyebrow">{{ block.settings.group | escape }}</p>{% assign previous_group = block.settings.group %}{% endif %}<details><summary>{{ block.settings.question | escape }} {% render 'nfc-icon', name: 'plus' %}</summary><div class="rte">{{ block.settings.answer }}{% if block.settings.page != blank %}{{ block.settings.page.content }}{% endif %}</div></details></div>{% endfor %}</div><div class="faq-contact"><div><p class="eyebrow">{{ section.settings.contact_eyebrow | escape }}</p><h2>{{ section.settings.contact_heading | escape }}</h2></div><a class="nfc-button nfc-button--dark" href="{{ section.settings.contact_link | default: '/pages/contact' }}">{{ section.settings.contact_label | escape }} {% render 'nfc-icon', name: 'arrow' %}</a></div></div></section>
{% schema %}
{
  "name": "NFC faq",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "HERE TO HELP"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "FREQUENTLY ASKED QUESTIONS"
    },
    {
      "type": "text",
      "id": "copy",
      "label": "Description",
      "default": "Find answers to common questions about shopping with Nuts for Christ."
    },
    {
      "type": "text",
      "id": "contact_eyebrow",
      "label": "Contact eyebrow",
      "default": "WE'RE HERE TO HELP"
    },
    {
      "type": "text",
      "id": "contact_heading",
      "label": "Contact heading",
      "default": "Still have questions?"
    },
    {
      "type": "text",
      "id": "contact_label",
      "label": "Contact button",
      "default": "Contact us"
    },
    {
      "type": "url",
      "id": "contact_link",
      "label": "Contact link"
    },
    {
      "type": "header",
      "content": "Section colors"
    },
    {
      "type": "paragraph",
      "content": "Leave a color empty to keep the original design. These controls affect only this section."
    },
    {
      "type": "color",
      "id": "nfc_background_color",
      "label": "Background"
    },
    {
      "type": "color",
      "id": "nfc_heading_color",
      "label": "Headings"
    },
    {
      "type": "color",
      "id": "nfc_text_color",
      "label": "Paragraphs and body text"
    },
    {
      "type": "color",
      "id": "nfc_eyebrow_color",
      "label": "Eyebrow text"
    },
    {
      "type": "color",
      "id": "nfc_link_color",
      "label": "Links"
    },
    {
      "type": "color",
      "id": "nfc_accent_color",
      "label": "Accents"
    },
    {
      "type": "color",
      "id": "nfc_border_color",
      "label": "Borders and dividers"
    },
    {
      "type": "header",
      "content": "Section buttons"
    },
    {
      "type": "color",
      "id": "nfc_button_text",
      "label": "Button text and icons"
    },
    {
      "type": "color",
      "id": "nfc_button_background",
      "label": "Filled button background"
    },
    {
      "type": "color",
      "id": "nfc_button_border",
      "label": "Button border"
    },
    {
      "type": "color",
      "id": "nfc_button_hover_text",
      "label": "Button hover text"
    },
    {
      "type": "color",
      "id": "nfc_button_hover_background",
      "label": "Filled button hover background"
    },
    {
      "type": "header",
      "content": "Section layout"
    },
    {
      "type": "select",
      "id": "nfc_content_position",
      "label": "Content column position",
      "default": "center",
      "options": [
        {
          "value": "default",
          "label": "Original design"
        },
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ]
    },
    {
      "type": "select",
      "id": "nfc_text_alignment",
      "label": "Heading alignment",
      "default": "center",
      "options": [
        {
          "value": "default",
          "label": "Original design"
        },
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ]
    },
    {
      "type": "checkbox",
      "id": "nfc_custom_width",
      "label": "Customize content width",
      "default": true
    },
    {
      "type": "range",
      "id": "nfc_content_width",
      "label": "Content width",
      "min": 480,
      "max": 1600,
      "step": 20,
      "default": 860,
      "unit": "px"
    },
    {
      "type": "header",
      "content": "Section typography"
    },
    {
      "type": "checkbox",
      "id": "nfc_custom_typography",
      "label": "Customize text sizes",
      "default": false
    },
    {
      "type": "range",
      "id": "nfc_heading_size",
      "label": "Heading size on desktop",
      "min": 20,
      "max": 140,
      "step": 2,
      "default": 56,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "nfc_heading_size_mobile",
      "label": "Heading size on mobile",
      "min": 20,
      "max": 100,
      "step": 2,
      "default": 36,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "nfc_paragraph_size",
      "label": "Paragraph size on desktop",
      "min": 10,
      "max": 30,
      "step": 1,
      "default": 14,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "nfc_paragraph_size_mobile",
      "label": "Paragraph size on mobile",
      "min": 10,
      "max": 30,
      "step": 1,
      "default": 14,
      "unit": "px"
    },
    {
      "type": "header",
      "content": "Section padding"
    },
    {
      "type": "text",
      "id": "nfc_padding_desktop",
      "label": "Padding on desktop",
      "info": "Top right bottom left. Example: 60px 20px 60px 20px. Leave blank to keep the design defaults."
    },
    {
      "type": "text",
      "id": "nfc_padding_mobile",
      "label": "Padding on mobile",
      "info": "Top right bottom left. Example: 60px 20px 60px 20px. Leave blank to keep the design defaults."
    },
    {
      "type": "header",
      "content": "Section margin"
    },
    {
      "type": "text",
      "id": "nfc_margin_desktop",
      "label": "Margin on desktop",
      "info": "Top right bottom left. Example: 60px 20px 60px 20px. Leave blank to keep the design defaults."
    },
    {
      "type": "text",
      "id": "nfc_margin_mobile",
      "label": "Margin on mobile",
      "info": "Top right bottom left. Example: 60px 20px 60px 20px. Leave blank to keep the design defaults."
    }
  ],
  "blocks": [
    {
      "type": "question",
      "name": "Question",
      "settings": [
        {
          "type": "text",
          "id": "group",
          "label": "Group heading",
          "default": "01 / ORDERS & PAYMENTS"
        },
        {
          "type": "text",
          "id": "question",
          "label": "Question",
          "default": "How can I track my order?"
        },
        {
          "type": "richtext",
          "id": "answer",
          "label": "Answer"
        },
        {
          "type": "page",
          "id": "page",
          "label": "Answer from page"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "NFC faq",
      "blocks": [
        {
          "type": "question"
        }
      ]
    }
  ]
}
{% endschema %}
