    },
    {
      "type": "header",
      "content": "Text & Colors"
    },
    {
      "type": "text",
      "id": "counter_text",
      "label": "Counter Text",
      "default": "03 / 11"
    },
    {
      "type": "text",
      "id": "subtitle_text",
      "label": "Subtitle Text",
      "default": "· BRAND STORY"
    },
    {
      "type": "text",
      "id": "title_line_1",
      "label": "Title Line 1",
      "default": "Every gift tells"
    },
    {
      "type": "text",
      "id": "title_highlight_1",
      "label": "Highlighted Text Line 1",
      "default": "a"
    },
    {
      "type": "text",
      "id": "title_line_2",
      "label": "Title Line 2",
      "default": "story."
    },
    {
      "type": "text",
      "id": "title_highlight_2",
