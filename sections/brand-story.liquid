    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent / Highlight Color",
      "default": "#c5a880"
    },
    {
      "type": "color",
      "id": "desc_color",
      "label": "Description Text Color",
      "default": "#cccccc"
    },
    {
      "type": "range",
      "id": "main_title_size",
      "min": 28,
      "max": 64,
      "step": 2,
      "unit": "px",
      "label": "Main Title Font Size",
      "default": 48
    },
    {
      "type": "range",
      "id": "desc_size",
      "min": 12,
