      "max": 120,
      "step": 5,
      "unit": "px",
      "label": "Padding Top",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 20,
      "max": 120,
      "step": 5,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 80
    },
    {
      "type": "header",
      "content": "Left Side Image / Quote Card"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Custom Image (Replaces Quote Card if added)"
    },
    {
      "type": "color",
