<section class="shop-page page-width"><header class="shop-heading"><p class="eyebrow">{{ section.settings.eyebrow | escape }}</p><h1>{{ section.settings.heading | escape }}</h1></header><form class="search-page-form" action="{{ routes.search_url }}" method="get"><label class="sr-only" for="Search-{{ section.id }}">Search products</label><input id="Search-{{ section.id }}" name="q" type="search" placeholder="Search catalog" value="{{ search.terms | escape }}"><input type="hidden" name="type" value="product"><input type="hidden" name="options[prefix]" value="last"><button class="nfc-button nfc-button--dark">Search {% render 'nfc-icon', name: 'search' %}</button></form>
{% if search.performed %}{% paginate search.results by 16 %}<p class="form-note">{{ search.results_count }} results for “{{ search.terms | escape }}”</p><div class="product-grid">{% for item in search.results %}{% if item.object_type == 'product' %}{% render 'nfc-product-card', product: item %}{% else %}<a href="{{ item.url }}">{{ item.title | escape }}</a>{% endif %}{% else %}{% render 'nfc-empty', heading: 'No results found', copy: 'Try another search term.' %}{% endfor %}</div>{% render 'nfc-pagination', paginate: paginate %}{% endpaginate %}{% endif %}</section>
{% schema %}
{
  "name": "NFC search",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "FIND YOUR NEXT STATEMENT"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "SEARCH"
    }
  ]
}
{% endschema %}
