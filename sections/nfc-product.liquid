{% assign current_variant = product.selected_or_first_available_variant %}{% assign product_form_id = 'ProductForm-' | append: section.id %}
<section class="product-page page-width" data-product-section data-available-text="{{ section.settings.available_text | escape }}"><nav class="breadcrumb" aria-label="Breadcrumb"><a href="{{ routes.root_url }}">Home</a><span>/</span><a href="{{ collection.url | default: routes.all_products_collection_url }}">{{ collection.title | default: 'Shop all' | escape }}</a><span>/</span><span>{{ product.title | escape }}</span></nav>
<div class="product-detail"><div class="product-gallery"><div class="product-gallery__main" data-gallery-main>{% if current_variant.featured_image or product.featured_image %}{% assign main_image = current_variant.featured_image | default: product.featured_image %}{{ main_image | image_url: width: 1600 | image_tag: widths: '540, 750, 1100, 1600', sizes: '(max-width: 700px) 100vw, 55vw', loading: 'eager', alt: main_image.alt }}{% else %}{{ 'product-1' | placeholder_svg_tag }}{% endif %}</div>
<div class="product-gallery__thumbs">{% for media in product.media %}{% if media.media_type == 'image' %}<button class="nfc-button nfc-button--gallery" type="button" data-gallery-image="{{ media | image_url: width: 1600 }}" data-image-alt="{{ media.alt | escape }}" aria-label="View image {{ forloop.index }}" aria-pressed="{% if media.id == main_image.id %}true{% else %}false{% endif %}">{{ media | image_url: width: 180 | image_tag: loading: 'lazy', alt: media.alt }}</button>{% endif %}{% endfor %}</div>
{% for media in product.media %}{% unless media.media_type == 'image' %}<div class="product-extra-media">{{ media | media_tag: image_size: '1100x', controls: true, preload: 'none' }}</div>{% endunless %}{% endfor %}</div>
<div class="product-detail__info"><p class="eyebrow">{{ section.settings.eyebrow | escape }}{% if section.settings.show_vendor %} / {{ product.vendor | escape }}{% endif %}</p><h1>{{ product.title | escape }}</h1><span class="product-price" data-variant-price>{{ current_variant.price | money }} {% if current_variant.compare_at_price > current_variant.price %}<s>{{ current_variant.compare_at_price | money }}</s>{% endif %}</span><div class="product-detail__description rte">{{ product.description }}</div>
{% form 'product', product, id: product_form_id, data-add-to-cart: '' %}
{% if form.errors %}<div role="alert">{{ form.errors | default_errors }}</div>{% endif %}
{% unless product.has_only_default_variant %}{% for option in product.options_with_values %}<fieldset class="variant-picker"><legend>{{ option.name | escape }} <span data-selected-option="{{ forloop.index0 }}">{{ option.selected_value | escape }}</span></legend><div class="variant-picker__options">{% assign option_index = forloop.index0 %}{% for value in option.values %}<label class="variant-choice"><input type="radio" name="options[{{ option.name | escape }}]" value="{{ value | escape }}" data-option-index="{{ option_index }}" {% if option.selected_value == value %}checked{% endif %}><span>{{ value | escape }}</span></label>{% endfor %}</div></fieldset>{% endfor %}{% endunless %}
<label class="{% unless product.has_only_default_variant %}sr-only{% endunless %}" for="Variant-{{ section.id }}">Variant</label><select id="Variant-{{ section.id }}" name="id" data-variant-select>{% for variant in product.variants %}<option value="{{ variant.id }}" {% if variant.id == current_variant.id %}selected{% endif %}>{{ variant.title | escape }} — {{ variant.price | money }}{% unless variant.available %} — {{ settings.nfc_sold_out_label | escape }}{% endunless %}</option>{% endfor %}</select>
{% if product.selling_plan_groups.size > 0 %}<label for="SellingPlan-{{ section.id }}">Purchase option</label><select id="SellingPlan-{{ section.id }}" name="selling_plan">{% unless product.requires_selling_plan %}<option value="">One-time purchase</option>{% endunless %}{% for group in product.selling_plan_groups %}<optgroup label="{{ group.name | escape }}">{% for plan in group.selling_plans %}<option value="{{ plan.id }}">{{ plan.name | escape }}</option>{% endfor %}</optgroup>{% endfor %}</select>{% endif %}
<div class="product-buy-row"><label class="quantity-control quantity-control--large"><span class="sr-only">Quantity</span><input type="number" name="quantity" min="{{ current_variant.quantity_rule.min | default: 1 }}" step="{{ current_variant.quantity_rule.increment | default: 1 }}" {% if current_variant.quantity_rule.max %}max="{{ current_variant.quantity_rule.max }}"{% endif %} value="{{ current_variant.quantity_rule.min | default: 1 }}" required></label><button class="nfc-button nfc-button--dark product-add" type="submit" name="add" data-add-button {% unless current_variant.available %}disabled{% endunless %}>{% if current_variant.available %}{{ settings.nfc_add_label | escape }}{% else %}{{ settings.nfc_sold_out_label | escape }}{% endif %}</button></div><p class="availability-note" data-availability>{% if current_variant.available %}{{ section.settings.available_text | escape }}{% else %}{{ settings.nfc_sold_out_label | escape }}{% endif %}</p><p data-form-status role="status"></p>{% if section.settings.show_dynamic_checkout %}{{ form | payment_button }}{% endif %}{% endform %}
{% if section.settings.show_wishlist %}<div class="product-save-row"><button class="nfc-button nfc-button--icon" type="button" data-wishlist-toggle="{{ product.handle }}" aria-pressed="false" aria-label="Save this piece">{% render 'nfc-icon', name: 'heart' %}</button><a href="{{ routes.root_url }}pages/wishlist">Saved pieces</a><span class="form-note" data-wishlist-status role="status"></span></div>{% endif %}<div class="product-accordions">{% for block in section.blocks %}{% if block.type == '@app' %}{% render block %}{% else %}<details {{ block.shopify_attributes }}><summary>{{ block.settings.heading | escape }} {% render 'nfc-icon', name: 'plus' %}</summary><div class="rte">{{ block.settings.content }}{% if block.settings.page != blank %}{{ block.settings.page.content }}{% endif %}</div></details>{% endif %}{% endfor %}</div>
</div></div><script type="application/json" data-product-json>{{ product | json }}</script>
<script type="application/ld+json">{{ product | structured_data }}</script>
{% assign related = section.settings.related_collection | default: collection %}{% if related != blank and section.settings.show_related %}<div class="related-section"><div class="section-heading"><p class="eyebrow">THE COLLECTION</p><h2>{{ section.settings.related_heading | escape }}</h2></div><div class="product-grid">{% assign shown = 0 %}{% for related_product in related.products %}{% unless related_product.id == product.id %}{% render 'nfc-product-card', product: related_product %}{% assign shown = shown | plus: 1 %}{% if shown == 4 %}{% break %}{% endif %}{% endunless %}{% endfor %}</div></div>{% endif %}</section>
{% schema %}
{
  "name": "NFC product",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "NUTS FOR CHRIST"
    },
    {
      "type": "checkbox",
      "id": "show_vendor",
      "label": "Show vendor",
      "default": false
    },
    {
      "type": "text",
      "id": "available_text",
      "label": "Availability message",
      "default": "Available now"
    },
    {
      "type": "checkbox",
      "id": "show_dynamic_checkout",
      "label": "Show accelerated checkout",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_related",
      "label": "Show related products",
      "default": true
    },
    {
      "type": "collection",
      "id": "related_collection",
      "label": "Related collection"
    },
    {
      "type": "text",
      "id": "related_heading",
      "label": "Related heading",
      "default": "COMPLETE YOUR ROTATION"
    },
    {
      "type": "checkbox",
      "id": "show_wishlist",
      "label": "Show save to wishlist",
      "default": true
    }
  ],
  "blocks": [
    {
      "type": "accordion",
      "name": "Information accordion",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Shipping & returns"
        },
        {
          "type": "richtext",
          "id": "content",
          "label": "Content"
        },
        {
          "type": "page",
          "id": "page",
          "label": "Page content"
        }
      ]
    },
    {
      "type": "@app"
    }
  ]
}
{% endschema %}
