{%- if section.settings.enable -%}
  {%- liquid
    assign type = section.settings.announ_type
    assign scroll_type = section.settings.scroll_type
    assign speed = section.settings.speed
    assign size_icon = section.settings.size_icon
  -%}
  <style>
    .announcement-slide {
      background: {%- if section.settings.gradient_bg != blank -%}
        {{ section.settings.gradient_bg }}
      {%- else -%}
        {{ section.settings.background }}
      {%- endif -%};
      color: {{ section.settings.text }};
      --color-body-text-rgb: {{ section.settings.text.red }}, {{ section.settings.text.green }}, {{ section.settings.text.blue }};
      font-family: 'Jost', var(--g-font-2), -apple-system, BlinkMacSystemFont, sans-serif;
      text-transform: uppercase;
      letter-spacing: {{ section.settings.letter_spacing | default: '0.25' }}em;
      font-weight: 500;
      font-size: {{ section.settings.font_size | default: 11.5 }}px;
      line-height: 1.4;
      padding: 9px 15px;
      position: relative;
      z-index: 100;
      border-bottom: 1px solid rgba(14, 12, 9, 0.15);
      border-top: 1px solid rgba(14, 12, 9, 0.08);
    }
    .announcement-slide .announcement-main-text {
      color: {{ section.settings.text }};
      letter-spacing: {{ section.settings.letter_spacing | default: '0.25' }}em;
      font-weight: 500;
      display: inline-block;
      text-align: center;
    }
    .announcement-slide a {
      color: {{ section.settings.text }};
      text-decoration: none;
      transition: opacity 0.2s ease, color 0.2s ease;
    }
    .announcement-slide a:hover {
      color: {{ section.settings.text_hover | default: section.settings.text }};
      opacity: 0.85;
    }
    .site-announcement-bar {
      --announcement-text-hover:{{ section.settings.text_hover }};
    }
    .site-announcement-contain {
      display: flex;
      justify-content: center;
      align-items: center;
      text-align: center;
      width: 100%;
    }
    .announcement-swiper {
      margin-left: auto;
      margin-right: auto;
      position: relative;
      overflow: hidden;
      list-style: none;
      padding: 0;
      z-index: 1;
    }

    .announcement-swiper .swiper-button-prev,
    .announcement-swiper .swiper-button-next {
      background: transparent;
      box-shadow: none;
    }
    .announcement-swiper .swiper-button-prev:after,
    .announcement-swiper .swiper-button-next:after {
      color: {{ section.settings.text }};
    }
    .announcement-swiper .rte a {
      color: rgb(var(--color-body-text-rgb));
    }
    @media(max-width:768px) {
      .announcement-slide {
        font-size: 10px;
        letter-spacing: 0.16em;
        padding: 7px 10px;
      }
      .announcement-slide .announcement-main-text {
        letter-spacing: 0.16em;
      }
      .site-announcement-contain {
        display: flex !important;
      }
      .announcement-swiper {
        overflow: inherit;
      }
      .announcement-swiper .swiper-button-prev {
        left: -20px;
      }
      .announcement-swiper .swiper-button-next {
        right: -20px;
      }
    }
    .announcement-slide.announcement-single .swiper-button-prev,
    .announcement-slide.announcement-single .swiper-button-next {
      display: none;
    }
    .announcement-scroll {
      grid: auto / auto-flow max-content;
      justify-content: center;
      display: grid;
      overflow: hidden;
    }

    .announcement-item {
      grid: auto / auto-flow auto 10rem;
      place-items: center;
      display: grid;
      animation-duration: {{ speed }}s;
    }
    .announcement-dot {
      width: 4px;
      height: 4px;
      display: block;
      border-radius: 50%;
      background-color: {{ section.settings.text }};
    }
    .announcement-line {
      width: 32px;
      height: 1px;
      display: block;
      background-color: {{ section.settings.text }};
    }
    .announcement-item__in .image-content__image {
      width: {{ size_icon }}px;
    }
    .announcement-item__in .link {
      color: rgba(var(--color-body-text-rgb), 1);
      text-decoration-color: rgba(var(--color-body-text-rgb), 1);
    }
    .site-announcement-bar__list {
      list-style: none;
    }
    .site-announcement-bar__list-item {
      line-height: 1;
      padding: 0 18px;
      border-right: 1px solid rgba(14, 12, 9, 0.2);
    }
    .site-announcement-bar__list-item:last-child {
      border: none;
      padding: 0;
      padding-left: 18px;
    }
    .site-announcement-bar a:hover {
      color:var(--announcement-text-hover);
    }
  </style>
  <!-- announcement-bar-slide.liquid -->

  {% if type == 'default' %}
    <div class="announcement-slide announcement-bar-default text-center"  
      data-section-id="{{ section.id }}">
      <div class="{{ section.settings.setwidth }} site-announcement-contain mx-auto">
        {%- for block in section.blocks -%}
          {%- case block.type -%}
            {%- when 'item_default' -%}
              <div class="announcement-main-text text-center py-1" {{ block.shopify_attributes }}>
                {%- if block.settings.button_link != blank -%}
                  <a href="{{ block.settings.button_link }}">{{ block.settings.code }}</a>
                {%- else -%}
                  <span>{{ block.settings.code }}</span>
                {%- endif -%}
              </div>
            {%- when 'Item' -%}
              <div class="announcement-main-text text-center py-1" {{ block.shopify_attributes }}>
                {%- if block.settings.button_link != blank -%}
                  <a href="{{ block.settings.button_link }}">{{ block.settings.code }}</a>
                {%- else -%}
                  <span>{{ block.settings.code }}</span>
                {%- endif -%}
              </div>
          {%- endcase -%}
        {%- endfor -%}
      </div>
    </div>
  {%- else -%}

    <div
      class="announcement-bar-carousel announcement-slide d-flex {% if section.blocks.size == 1 %} announcement-single {% endif %}"
      data-section-id="{{ section.id }}"
      data-section-type="announcementswiper">
      {%- if type == 'carousel' -%}
        <div class="announcement-wrapper container text-center ">
          <div class="row justify-content-center">
            <div class="col-lg-7 col-12">
              <div class="swiper announcement-swiper announswipercol-{{ section.id }}">
                <div class="swiper-wrapper">
                  {%- for block in section.blocks -%}
                    {%- case block.type -%}
                      {%- when 'Item' -%}
                      <div class="swiper-slide rte m-0">
                        <div class="py-2 {{ section.settings.size_text }}">
                          {{ block.settings.code }}
                          {% if block.settings.button_text != blank %}
                            <a class="d-inline-block px-2" href="{{ block.settings.button_link }}">{{ block.settings.button_text }}</a>
                          {% endif %}
                        </div>
                      </div>
                    {%- endcase -%}
                  {%- endfor -%}
                </div>
                <div class="swiper-button-prev"></div>
                <div class="swiper-button-next"></div>
              </div>
            </div>
          </div>
        </div>

      {%- else -%}
        <div class="announcement-wrapper announcement-scroll py-2">
          {%- for i in (1..10) -%}
            <span class="announcement-item  {% if scroll_type == 'from-left' %} anim-loop-left {% else %} anim-loop-right {% endif %}">
              {%- for block in section.blocks -%}
                <span class="announcement-item__in {{ section.settings.size_text }} d-flex align-items-center">
                  {% if block.settings.image != blank %}
                    <img
                      class="image-content__image mr-2"
                      src="{{ block.settings.image | image_url: width: 240 }}"
                      alt="{{ block.settings.image.alt | escape }}"
                      loading="lazy"
                      width="{{ block.settings.image.width }}"
                      height="{{ block.settings.image.height }}">
                  {% endif %}
                  {{ block.settings.code }}
                  {% if block.settings.button_text != blank %}
                    <a class="d-inline-block px-2 link" href="{{ block.settings.button_link }}">
                      {{ block.settings.button_text }}</a>
                  {% endif %}
                </span>
                <span class="announcement-{{ section.settings.scroll_dot }}"></span>
              {%- endfor -%}
            </span>
          {%- endfor -%}
        </div>
      {%- endif -%}

    </div>

  {%- endif -%}
{%- endif -%}

{% schema %}
