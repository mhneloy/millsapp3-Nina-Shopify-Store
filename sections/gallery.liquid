{% comment %}
  Section: Dynamic Swiper Image & Video Slider (Smooth Autoplay + Video Ratio Modal/Overlay)
{% endcomment %}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css" />

{% style %}
  #shopify-section-{{ section.id }} .custom-swiper-wrapper {
    background-color: {{ section.settings.bg_color }};
    padding: {{ section.settings.section_padding_top }}px 20px {{ section.settings.section_padding_bottom }}px 20px;
    position: relative;
  }

  #shopify-section-{{ section.id }} .swiper-slide {
    display: flex;
    justify-content: center;
    align-items: center;
    overflow: hidden;
    background-color: {{ section.settings.slide_bg_color }};
    border-radius: {{ section.settings.slide_border_radius }}px;
  }

  #shopify-section-{{ section.id }} .media-container {
    position: relative;
    width: 100%;
    aspect-ratio: {{ section.settings.media_aspect_ratio }};
    overflow: hidden;
    cursor: pointer;
  }

  #shopify-section-{{ section.id }} .media-container img,
  #shopify-section-{{ section.id }} .media-container video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  /* Video Zoom/Expand Overlay mode with its original aspect ratio */
  .video-modal-overlay {
    position: fixed;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100vh;
    background: rgba(0, 0, 0, 0.85);
    z-index: 999999;
    display: flex;
    justify-content: center;
    align-items: center;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.3s ease;
  }

  .video-modal-overlay.active {
    opacity: 1;
    visibility: visible;
  }

  .video-modal-content {
    position: relative;
    max-width: 90vw;
    max-height: 90vh;
    display: flex;
    justify-content: center;
    align-items: center;
  }

  .video-modal-content video {
    width: auto;
    height: auto;
    max-width: 90vw;
    max-height: 90vh;
    object-fit: contain;
    border-radius: 8px;
    box-shadow: 0 10px 30px rgba(0,0,0,0.5);
  }

  .video-modal-close {
    position: absolute;
    top: -40px;
    right: 0;
    background: #ffffff;
    color: #000000;
    border: none;
    font-size: 18px;
    font-weight: bold;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    cursor: pointer;
  }

  /* Swiper Navigation Arrows Custom Color */
  #shopify-section-{{ section.id }} .swiper-button-next,
  #shopify-section-{{ section.id }} .swiper-button-prev {
    color: {{ section.settings.arrow_color }} !important;
    background-color: {{ section.settings.arrow_bg_color }};
    width: 44px;
    height: 44px;
    border-radius: 50%;
    {% unless section.settings.show_arrows %}display: none !important;{% endunless %}
  }

  #shopify-section-{{ section.id }} .swiper-button-next::after,
  #shopify-section-{{ section.id }} .swiper-button-prev::after {
    font-size: 18px;
    font-weight: bold;
  }

  /* Swiper Pagination Dots Custom Color */
  #shopify-section-{{ section.id }} .swiper-pagination {
    {% unless section.settings.show_dots %}display: none !important;{% endunless %}
    position: relative;
    margin-top: 20px;
  }

  #shopify-section-{{ section.id }} .swiper-pagination-bullet {
    background: {{ section.settings.dot_color }} !important;
    opacity: 1 !important;
    width: 10px;
    height: 10px;
    margin: 0 4px !important;
  }

  #shopify-section-{{ section.id }} .swiper-pagination-bullet-active {
    background: {{ section.settings.dot_active_color }} !important;
    width: 22px;
    border-radius: 5px;
  }
{% endstyle %}

{% comment %} Metafield Data Extraction Logic {% endcomment %}
{% assign metafield_key = section.settings.metafield_key %}
{% assign has_metafield_data = false %}
{% assign meta_items = null %}

{% if metafield_key != blank %}
  {% assign parts = metafield_key | split: '.' %}
  {% assign namespace = parts[0] %}
  {% assign key = parts[1] %}
  
  {% if product.metafields[namespace][key] != blank %}
    {% assign meta_items = product.metafields[namespace][key].value %}
    {% if meta_items.size > 0 %}
      {% assign has_metafield_data = true %}
    {% endif %}
  {% elsif page.metafields[namespace][key] != blank %}
    {% assign meta_items = page.metafields[namespace][key].value %}
    {% if meta_items.size > 0 %}
      {% assign has_metafield_data = true %}
    {% endif %}
  {% endif %}
{% endif %}

<div class="custom-swiper-wrapper">
  <div class="swiper mySwiper-{{ section.id }}">
    <div class="swiper-wrapper">

      {% comment %} 1. Load from Metafields if available {% endcomment %}
      {% if has_metafield_data %}
        {% for item in meta_items %}
          <div class="swiper-slide">
            <div class="media-container {% if item.media_type == 'video' or item.mime_type contains 'video' %}trigger-video-modal{% endif %}">
              {% if item.media_type == 'video' or item.mime_type contains 'video' %}
                <video 
                  src="{{ item.sources[0].url | default: item.url }}" 
                  {% if section.settings.autoplay_video %}autoplay muted{% endif %} 
                  {% if section.settings.loop_video %}loop{% endif %}
                  playsinline 
                  preload="metadata"
                ></video>
              {% else %}
                <img src="{{ item | image_url: width: 1200 }}" alt="{{ item.alt | escape }}" loading="lazy">
              {% endif %}
            </div>
          </div>
        {% endfor %}

      {% comment %} 2. Fallback to Section Blocks {% endcomment %}
      {% elsif section.blocks.size > 0 %}
        {% for block in section.blocks %}
          <div class="swiper-slide" {{ block.shopify_attributes }}>
            <div class="media-container {% if block.settings.slide_type == 'video' %}trigger-video-modal{% endif %}">
              {% if block.settings.slide_type == 'video' %}
                {% if block.settings.video_url != blank %}
                  <video 
                    src="{{ block.settings.video_url }}" 
                    {% if section.settings.autoplay_video %}autoplay muted{% endif %} 
                    {% if section.settings.loop_video %}loop{% endif %}
                    playsinline 
                    preload="metadata"
                  ></video>
                {% elsif block.settings.hosted_video != blank %}
                  {{ block.settings.hosted_video | video_tag: autoplay: section.settings.autoplay_video, loop: section.settings.loop_video, preload: "metadata" }}
                {% endif %}
              {% else %}
                {% if block.settings.image != blank %}
                  <img src="{{ block.settings.image | image_url: width: 1200 }}" alt="{{ block.settings.image.alt | escape }}" loading="lazy">
                {% else %}
                  {{ 'image' | placeholder_svg_tag }}
                {% endif %}
              {% endif %}
            </div>
          </div>
        {% endfor %}
      {% endif %}

    </div>

    {% if section.settings.show_arrows %}
      <div class="swiper-button-next"></div>
      <div class="swiper-button-prev"></div>
    {% endif %}
  </div>

  {% if section.settings.show_dots %}
    <div class="swiper-pagination swiper-pagination-{{ section.id }}"></div>
  {% endif %}
</div>

<!-- Global Video Pop-up Modal Viewer -->
<div class="video-modal-overlay" id="videoModal-{{ section.id }}">
  <div class="video-modal-content">
    <button type="button" class="video-modal-close">&times;</button>
    <video controls playsinline></video>
  </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js"></script>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    const isInfiniteEnabled = {{ section.settings.enable_infinite | json }};
    const isSliderAutoplay = {{ section.settings.enable_autoplay | json }};
    const autoplaySpeed = {{ section.settings.autoplay_speed | times: 1000 }};

    const swiperConfig = {
      loop: isInfiniteEnabled,
      spaceBetween: {{ section.settings.space_between }},
      slidesPerView: {{ section.settings.slides_per_view_mobile }},
      breakpoints: {
        768: { slidesPerView: {{ section.settings.slides_per_view_tablet }} },
        1024: { slidesPerView: {{ section.settings.slides_per_view_desktop }} }
      },
      navigation: {
        nextEl: '.swiper-button-next',
        prevEl: '.swiper-button-prev',
      },
      pagination: {
        el: '.swiper-pagination-{{ section.id }}',
        clickable: true,
      }
    };

    if (isSliderAutoplay) {
      swiperConfig.autoplay = {
        delay: 0,
        disableOnInteraction: false,
      };
      swiperConfig.speed = autoplaySpeed; // Makes transition smooth and continuous (linear feel)
    }

    const swiper = new Swiper('.mySwiper-{{ section.id }}', swiperConfig);

    // Video Full-screen Modal Popup (Original Ratio & High z-index)
    const modal = document.getElementById('videoModal-{{ section.id }}');
    const modalVideo = modal.querySelector('video');
    const closeBtn = modal.querySelector('.video-modal-close');
    const videoContainers = document.querySelectorAll('#shopify-section-{{ section.id }} .trigger-video-modal');

    videoContainers.forEach(container => {
      container.addEventListener('click', function () {
        const sourceVideo = this.querySelector('video');
        if (sourceVideo) {
          const videoSrc = sourceVideo.currentSrc || sourceVideo.src;
          modalVideo.src = videoSrc;
          modal.classList.add('active');
          modalVideo.play();
        }
      });
    });

    function closeModal() {
      modal.classList.remove('active');
      modalVideo.pause();
      modalVideo.src = '';
    }

    closeBtn.addEventListener('click', closeModal);
    modal.addEventListener('click', function (e) {
      if (e.target === modal) closeModal();
    });
  });
</script>

{% schema %}
{
  "name": "Custom Swiper Gallery",
  "settings": [
    {
      "type": "header",
      "content": "Metafield Source"
    },
    {
      "type": "text",
      "id": "metafield_key",
      "label": "Metafield Key (e.g. custom.gallery_files)",
      "info": "Metafield key dile seta auto detect korbe. Khali thakle block er items show hobe."
    },
    {
      "type": "header",
      "content": "Slides Per View (Responsive)"
    },
    {
      "type": "range",
      "id": "slides_per_view_desktop",
      "min": 1,
      "max": 6,
      "step": 1,
      "label": "Desktop Slides Per View",
      "default": 3
    },
    {
      "type": "range",
      "id": "slides_per_view_tablet",
      "min": 1,
      "max": 4,
      "step": 1,
      "label": "Tablet Slides Per View",
      "default": 2
    },
    {
      "type": "range",
      "id": "slides_per_view_mobile",
      "min": 1,
      "max": 3,
      "step": 1,
      "label": "Mobile Slides Per View",
      "default": 1
    },
    {
      "type": "range",
      "id": "space_between",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "label": "Space Between Slides",
      "default": 16
    },
    {
      "type": "header",
      "content": "Media Display & Aspect Ratio"
    },
    {
      "type": "select",
      "id": "media_aspect_ratio",
      "label": "Media Aspect Ratio",
      "default": "16 / 9",
      "options": [
        { "value": "16 / 9", "label": "16:9 Landscape" },
        { "value": "4 / 3", "label": "4:3 Standard" },
        { "value": "1 / 1", "label": "1:1 Square" },
        { "value": "9 / 16", "label": "9:16 Portrait" }
      ]
    },
    {
      "type": "range",
      "id": "slide_border_radius",
      "min": 0,
      "max": 30,
      "step": 2,
      "unit": "px",
      "label": "Slide Corner Radius",
      "default": 8
    },
    {
      "type": "header",
      "content": "Slider Behavior Controls"
    },
    {
      "type": "checkbox",
      "id": "enable_infinite",
      "label": "Enable Infinite Loop",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "enable_autoplay",
      "label": "Enable Smooth Slider Autoplay",
      "default": false
    },
    {
      "type": "range",
      "id": "autoplay_speed",
      "min": 1,
      "max": 8,
      "step": 1,
      "unit": "s",
      "label": "Autoplay Transition Speed",
      "default": 4
    },
    {
      "type": "checkbox",
      "id": "autoplay_video",
      "label": "Enable Video Autoplay in Slider",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "loop_video",
      "label": "Enable Video Loop",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_arrows",
      "label": "Show Navigation Arrows",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_dots",
      "label": "Show Pagination Dots",
      "default": true
    },
    {
      "type": "header",
      "content": "Full Color Controls"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Section Background Color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "slide_bg_color",
      "label": "Slide Background / Card Color",
      "default": "#f9f9f9"
    },
    {
      "type": "color",
      "id": "arrow_color",
      "label": "Arrow Icon Color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "arrow_bg_color",
      "label": "Arrow Background Color",
      "default": "transparent"
    },
    {
      "type": "color",
      "id": "dot_color",
      "label": "Pagination Dot Color",
      "default": "#cccccc"
    },
    {
      "type": "color",
      "id": "dot_active_color",
      "label": "Active Pagination Dot Color",
      "default": "#000000"
    },
    {
      "type": "header",
      "content": "Section Spacing"
    },
    {
      "type": "range",
      "id": "section_padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top Padding",
      "default": 40
    },
    {
      "type": "range",
      "id": "section_padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom Padding",
      "default": 40
    }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Media Slide",
      "settings": [
        {
          "type": "select",
          "id": "slide_type",
          "label": "Media Type",
          "default": "image",
          "options": [
            { "value": "image", "label": "Image" },
            { "value": "video", "label": "Video" }
          ]
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "video",
          "id": "hosted_video",
          "label": "Shopify Hosted Video"
        },
        {
          "type": "url",
          "id": "video_url",
          "label": "External Direct Video URL (.mp4)"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Custom Swiper Gallery",
      "blocks": [
        { "type": "slide" },
        { "type": "slide" },
        { "type": "slide" }
      ]
    }
  ]
}
{% endschema %}