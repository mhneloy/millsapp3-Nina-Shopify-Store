{% render 'nfc-section-style', section: section %}
<section class="category-section page-width" id="collection"><div class="section-heading"><p class="eyebrow">{{ section.settings.eyebrow | escape }}</p><h2>{{ section.settings.heading | escape | newline_to_br }}</h2></div><div class="category-grid">{% for block in section.blocks %}{% assign tile_collection = block.settings.collection %}{% assign tile_image = block.settings.image | default: tile_collection.image %}{% assign tile_link = block.settings.link | default: tile_collection.url | default: routes.all_products_collection_url %}
<a class="category-tile" href="{{ tile_link }}" {{ block.shopify_attributes }}>{% assign fallback = 'nfc-editorial-tee.jpg' %}{% if forloop.index == 2 %}{% assign fallback = 'nfc-editorial-hoodie.jpg' %}{% endif %}{% render 'nfc-image', image: tile_image, fallback: fallback, alt: block.settings.heading, loading: 'lazy', sizes: '(max-width: 700px) 100vw, 50vw' %}<span class="category-tile__number">{{ block.settings.eyebrow | escape }}</span><span class="category-tile__bottom"><span>{{ block.settings.heading | default: tile_collection.title | escape }}</span>{% render 'nfc-icon', name: 'arrow' %}</span></a>{% endfor %}</div>{% if section.settings.note != blank %}<p class="image-note">{{ section.settings.note | escape }}</p>{% endif %}</section>
{% schema %}
{
  "name": "NFC collection tiles",
