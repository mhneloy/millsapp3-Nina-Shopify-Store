{% comment %}

  Section: Legacy Tribute Hero (Single Background with Dynamic Overlay)

  Author: Custom Shopify 2.0 Section

{% endcomment %}



<link rel="preconnect" href="https://fonts.googleapis.com">

<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@400;500;600;700&family=Great+Vibes&family=Jost:wght@300;400;500;600;700&display=swap" rel="stylesheet">



{%- assign glow1_alpha = section.settings.btn1_glow_intensity | default: 50 | divided_by: 100.0 -%}
{%- assign glow1_c = section.settings.btn1_glow_color | default: '#DCB14F' -%}
{%- assign btn2_alpha = section.settings.btn2_bg_opacity | default: 0 | divided_by: 100.0 -%}
{%- assign btn2_bg_color = section.settings.btn2_bg | default: '#D9BA77' -%}
{%- assign btn2h_alpha = section.settings.btn2_hover_bg_opacity | default: 14 | divided_by: 100.0 -%}
{%- assign btn2h_bg_color = section.settings.btn2_bg_hover | default: '#DCB14F' -%}

<style>

  .legacy-hero-{{ section.id }} {
    --bg-color: {{ section.settings.bg_color | default: '#0E0C09' }};
    --overlay-color: {{ section.settings.overlay_color | default: '#000000' }};
    --overlay-opacity: {{ section.settings.overlay_opacity | default: 20 | divided_by: 100.0 }};
    --mobile-overlay-color: {% if section.settings.custom_mobile_overlay %}{{ section.settings.mobile_overlay_color | default: '#000000' }}{% else %}{{ section.settings.overlay_color | default: '#000000' }}{% endif %};
    --mobile-overlay-opacity: {% if section.settings.custom_mobile_overlay %}{{ section.settings.mobile_overlay_opacity | default: 40 | divided_by: 100.0 }}{% else %}{{ section.settings.overlay_opacity | default: 20 | divided_by: 100.0 }}{% endif %};
    --accent-gold: {{ section.settings.accent_color | default: '#DCB14F' }};
    --heading-color: {{ section.settings.heading_color | default: '#EEE7D9' }};
    --text-color: {{ section.settings.text_color | default: '#9F978B' }};
    --desktop-height: {{ section.settings.desktop_height | default: 100 }}vh;
    --mobile-height: {% if section.settings.mobile_height_mode == 'px' %}{{ section.settings.mobile_height_px | default: 650 }}px{% else %}{{ section.settings.mobile_height_vh | default: 90 }}vh{% endif %};
    --btn1-bg: {{ section.settings.btn1_bg | default: '#DCB14F' }};
    --btn1-border: {{ section.settings.btn1_border | default: '#DCB14F' }};
    --btn1-text-color: {{ section.settings.btn1_text_color | default: '#0E0C09' }};
    --btn1-bg-hover: {{ section.settings.btn1_bg_hover | default: '#DCB14F' }};
    --btn1-border-hover: {{ section.settings.btn1_border_hover | default: '#DCB14F' }};
    --btn1-text-hover: {{ section.settings.btn1_text_hover | default: '#0E0C09' }};
    --btn1-glow: {% if section.settings.btn1_enable_glow %}0 4px 15px rgba(0, 0, 0, 0.4), 0 0 {{ section.settings.btn1_glow_size | default: 25 }}px {% if glow1_c != blank and glow1_c.red != blank %}rgba({{ glow1_c.red }}, {{ glow1_c.green }}, {{ glow1_c.blue }}, {{ glow1_alpha }}){% else %}rgba(220, 177, 79, {{ glow1_alpha }}){% endif %}, 0 0 {{ section.settings.btn1_glow_size | default: 25 | times: 1.8 | round }}px {% if glow1_c != blank and glow1_c.red != blank %}rgba({{ glow1_c.red }}, {{ glow1_c.green }}, {{ glow1_c.blue }}, {{ glow1_alpha | times: 0.5 }}){% else %}rgba(220, 177, 79, {{ glow1_alpha | times: 0.5 }}){% endif %}{% else %}0 4px 15px rgba(0, 0, 0, 0.4){% endif %};
    --btn2-bg: {% if btn2_bg_color != blank and btn2_bg_color.red != blank %}rgba({{ btn2_bg_color.red }}, {{ btn2_bg_color.green }}, {{ btn2_bg_color.blue }}, {{ btn2_alpha }}){% elsif btn2_bg_color != blank %}{{ btn2_bg_color | color_modify: 'alpha', btn2_alpha }}{% else %}rgba(217, 186, 119, {{ btn2_alpha }}){% endif %};
    --btn2-border: {{ section.settings.btn2_border | default: '#D9BA77' }};
    --btn2-text-color: {{ section.settings.btn2_text_color | default: '#EAD297' }};
    --btn2-bg-hover: {% if btn2h_bg_color != blank and btn2h_bg_color.red != blank %}rgba({{ btn2h_bg_color.red }}, {{ btn2h_bg_color.green }}, {{ btn2h_bg_color.blue }}, {{ btn2h_alpha }}){% elsif btn2h_bg_color != blank %}{{ btn2h_bg_color | color_modify: 'alpha', btn2h_alpha }}{% else %}rgba(220, 177, 79, {{ btn2h_alpha }}){% endif %};
    --btn2-border-hover: {{ section.settings.btn2_border_hover | default: '#DCB14F' }};
    --btn2-text-hover: {{ section.settings.btn2_text_hover | default: '#F3DD99' }};

    position: relative;
    background-color: var(--bg-color);
    {% if section.settings.bg_image != blank %}
      background-image: url('{{ section.settings.bg_image | image_url: width: 2500 }}');
    {% else %}
      background-image: url('{{ 'goat-christmas-hero-banner.jpg' | asset_url }}');
    {% endif %}
    background-size: cover;
    background-position: {{ section.settings.bg_position_desktop | default: 'center center' }};
    background-repeat: no-repeat;
    min-height: var(--desktop-height, 100vh);
    display: flex;
    align-items: center;
    {% if section.settings.content_alignment_desktop == 'left' %}
      justify-content: flex-start;
      padding: 80px clamp(25px, 6.5vw, 120px);
    {% else %}
      justify-content: center;
      padding: 80px 20px;
    {% endif %}
    overflow: hidden;
    box-sizing: border-box;
  }



  /* Dynamic Color & Opacity Overlay */

  .legacy-hero-{{ section.id }}::before {

    content: '';

    position: absolute;

    inset: 0;

    background-color: var(--overlay-color);

    opacity: var(--overlay-opacity);

    z-index: 1;

    pointer-events: none;

  }



      /* =========================================================
     DYNAMIC LEFT BLUR OVERLAY (LARGE / DESKTOP SCREENS ONLY)
  ========================================================= */
  @media (min-width: 769px) {
    .legacy-hero-{{ section.id }} .legacy-hero__blur-overlay {
      position: absolute;
      top: {{ section.settings.blur_top | default: 0 }}%;
      bottom: {{ section.settings.blur_bottom | default: 0 }}%;
      left: {{ section.settings.blur_left | default: 0 }}%;
      width: {{ section.settings.blur_width_desktop | default: 50 }}%;
      backdrop-filter: blur({{ section.settings.blur_strength | default: 14 }}px);
      -webkit-backdrop-filter: blur({{ section.settings.blur_strength | default: 14 }}px);
      background: linear-gradient(
        to right,
        rgba(0, 0, 0, {{ section.settings.blur_darkness | default: 75 | times: 0.01 }}) 0%,
        rgba(0, 0, 0, {{ section.settings.blur_darkness | default: 75 | times: 0.0075 }}) 45%,
        rgba(0, 0, 0, {{ section.settings.blur_darkness | default: 75 | times: 0.0025 }}) 75%,
        transparent 100%
      );
      -webkit-mask-image: linear-gradient(
        to right,
        rgba(0, 0, 0, 1) 0%,
        rgba(0, 0, 0, 1) {{ section.settings.blur_fade_position | default: 70 }}%,
        rgba(0, 0, 0, 0) 100%
      );
      mask-image: linear-gradient(
        to right,
        rgba(0, 0, 0, 1) 0%,
        rgba(0, 0, 0, 1) {{ section.settings.blur_fade_position | default: 70 }}%,
        rgba(0, 0, 0, 0) 100%
      );
      z-index: 1;
      pointer-events: none;
    }
  }

  /* Mobile: completely disable blur overlay - keep original mobile view untouched */
  @media (max-width: 768px) {
    .legacy-hero-{{ section.id }} .legacy-hero__blur-overlay {
      display: none !important;
    }
  }

  /* Center Content Container */

  .legacy-hero-{{ section.id }} .legacy-hero__content {
    position: relative;
    z-index: 2;
    width: 100%;
    {% if section.settings.content_alignment_desktop == 'left' %}
      max-width: 600px;
      margin: 0;
      text-align: left;
      align-items: flex-start;
    {% else %}
      max-width: 780px;
      margin: 0 auto;
      text-align: center;
      align-items: center;
    {% endif %}
    padding: 0;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  



  .legacy-hero-{{ section.id }} .legacy-hero__subheading {
    font-family: 'Cinzel', serif;
    color: #F8F5EE;
    font-size: 13.5px;
    letter-spacing: 5px;
    text-transform: uppercase;
    font-weight: 500;
    margin-bottom: 8px;
    text-shadow: 0 2px 6px rgba(0, 0, 0, 0.85);
  }

  .legacy-hero-{{ section.id }} .legacy-hero__subheading::after {
    content: '';
    display: block;
    width: 55px;
    height: 1.5px;
    background: linear-gradient(90deg, #E6C57A 0%, #D4AF37 70%, transparent 100%);
    margin: 10px 0 25px 0;
    box-shadow: 0 0 8px rgba(220, 177, 79, 0.5);
  }
  {% if section.settings.content_alignment_desktop == 'center' %}
    .legacy-hero-{{ section.id }} .legacy-hero__subheading::after {
      margin-left: auto;
      margin-right: auto;
    }
  {% endif %}
  @media (max-width: 768px) {
    .legacy-hero-{{ section.id }} .legacy-hero__subheading::after {
      margin-left: auto;
      margin-right: auto;
    }
  }

    /* Heading Shimmer Keyframes */
  @-webkit-keyframes goldShimmerBackAndForth {
    0% {
      background-position: 0% 50%;
    }
    100% {
      background-position: 100% 50%;
    }
  }
  @keyframes goldShimmerBackAndForth {
    0% {
      background-position: 0% 50%;
    }
    100% {
      background-position: 100% 50%;
    }
  }

  .legacy-hero-{{ section.id }} .legacy-hero__heading {
    font-family: 'Great Vibes', cursive;
    font-size: clamp(52px, 5vw, 76px);
    line-height: 1.05;
    font-weight: 400;
    margin: 0 0 20px 0;
    letter-spacing: 0.5px;
    background: {%- if section.settings.heading_shimmer_gradient != blank -%}{{ section.settings.heading_shimmer_gradient }}{%- else -%}linear-gradient(105deg, #C69E58 0%, #F3DD99 25%, #AF874D 50%, #EDD696 75%, #C69E58 100%){%- endif -%};
    background-size: 250% auto;
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    color: transparent;
    filter: drop-shadow(0 3px 6px rgba(0, 0, 0, 0.75));
    {% if section.settings.enable_heading_shimmer %}
      -webkit-animation: goldShimmerBackAndForth {{ section.settings.heading_shimmer_speed | default: 6 }}s ease-in-out infinite alternate;
      animation: goldShimmerBackAndForth {{ section.settings.heading_shimmer_speed | default: 6 }}s ease-in-out infinite alternate;
    {% endif %}
  }

  .legacy-hero-{{ section.id }} .legacy-hero__heading br {
    display: none;
  }

  .legacy-hero-{{ section.id }} .legacy-hero__heading span,
  .legacy-hero-{{ section.id }} .legacy-hero__heading small {
    display: block;
    font-family: 'Cinzel', serif;
    font-size: 14px;
    letter-spacing: 6.5px;
    line-height: 1.3;
    text-transform: uppercase;
    font-weight: 500;
    color: #FFFFFF !important;
    -webkit-text-fill-color: #FFFFFF !important;
    background: none !important;
    margin-top: 2px;
    margin-bottom: 20px;
    padding-left: 35px;
    text-shadow: 0 2px 8px rgba(0, 0, 0, 0.9);
    filter: none;
  }

  .legacy-hero-{{ section.id }} .legacy-hero__heading span:last-child {
    margin-bottom: 25px;
  }

  .legacy-hero-{{ section.id }} .legacy-hero__heading span::before,
  .legacy-hero-{{ section.id }} .legacy-hero__heading small::before {
    content: "\2014\00a0";
    color: #DFC18D;
    margin-right: 8px;
    opacity: 0.85;
  }

  /* 2nd Subtext (FOR THE MAGIC) Clearance from 'Y' Descender Loop */
  .legacy-hero-{{ section.id }} .legacy-hero__heading span:nth-of-type(2),
  .legacy-hero-{{ section.id }} .legacy-hero__heading small:nth-of-type(2) {
    margin-top: 16px;
    margin-bottom: 22px;
    padding-left: 35px;
  }

  @media (max-width: 768px) {
    .legacy-hero-{{ section.id }} .legacy-hero__heading {
      font-size: clamp(44px, 11vw, 54px);
      line-height: 1.15;
    }
    .legacy-hero-{{ section.id }} .legacy-hero__heading span,
    .legacy-hero-{{ section.id }} .legacy-hero__heading small {
      font-size: 11.5px;
      letter-spacing: 4px;
      padding-left: 0 !important;
      margin-top: 2px;
      margin-bottom: 12px;
      text-align: center;
    }
    .legacy-hero-{{ section.id }} .legacy-hero__heading span::before,
    .legacy-hero-{{ section.id }} .legacy-hero__heading small::before {
      display: none;
    }
  }

  .legacy-hero-{{ section.id }} .legacy-hero__description {
    font-family: {% if section.settings.description_font_style == 'italic_serif' %}'Cormorant Garamond', Georgia, serif{% else %}'Jost', var(--g-font-2), sans-serif{% endif %};
    font-style: {% if section.settings.description_font_style == 'italic_serif' %}italic{% else %}normal{% endif %};
    color: var(--text-color, #E8DECB);
    font-size: {% if section.settings.description_font_style == 'italic_serif' %}19px{% else %}15px{% endif %};
    line-height: {% if section.settings.description_font_style == 'italic_serif' %}1.45{% else %}1.8{% endif %};
    max-width: 480px;
    margin: 0 0 35px 0;
    font-weight: {% if section.settings.description_font_style == 'italic_serif' %}400{% else %}300{% endif %};
    text-shadow: 0 2px 12px rgba(0,0,0,0.7);
  }



  /* Action Buttons */

  .legacy-hero-{{ section.id }} .legacy-hero__actions {

    display: flex;

    align-items: center;

    justify-content: center;

    gap: 16px;

    flex-wrap: wrap;

    margin-bottom: 45px;

  }

  .legacy-hero-{{ section.id }} .legacy-btn {

    font-family: 'Cinzel', serif;

    display: inline-flex;

    align-items: center;

    justify-content: center;

    padding: 13px 28px;

    font-size: 12px;

    font-weight: 600;

    letter-spacing: 1.8px;

    text-transform: uppercase;

    text-decoration: none;

    border-radius: 2px;

    transition: all 0.35s cubic-bezier(0.16, 1, 0.3, 1);

    cursor: pointer;

    box-sizing: border-box;

    position: relative;

    white-space: nowrap;

    -webkit-font-smoothing: antialiased;

    -moz-osx-font-smoothing: grayscale;

    text-rendering: optimizeLegibility;

    isolation: isolate;

    transform: translateZ(0);

    -webkit-backface-visibility: hidden;

    backface-visibility: hidden;

  }



  /* Primary Button: 100% Dynamic Linear Gradient with Radiant Glowing Hover */
  .legacy-hero-{{ section.id }} .legacy-btn--primary {
    background: {%- if section.settings.btn1_gradient != blank -%}{{ section.settings.btn1_gradient }}{%- else -%}var(--btn1-bg){%- endif -%};
    background-size: 200% auto;
    background-position: left center;
    color: var(--btn1-text-color);
    border: 1px solid var(--btn1-border, transparent);
    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.4);
    transition: all 0.35s cubic-bezier(0.16, 1, 0.3, 1), background-position 0.5s ease;
  }

  .legacy-hero-{{ section.id }} .legacy-btn--primary:hover {
    background-position: right center;
    color: var(--btn1-text-hover);
    border-color: var(--btn1-border-hover);
    filter: brightness(1.1);
    transform: translateY(-2px);
    box-shadow: var(--btn1-glow);
  }

  /* Secondary Button: Pure Frosted Glass Effect (Consistent with Website Theme Style) */
  .legacy-hero-{{ section.id }} .legacy-btn--secondary {
    background: var(--btn2-bg) !important;
    background-color: var(--btn2-bg) !important;
    color: var(--btn2-text-color) !important;
    border: 1px solid var(--btn2-border) !important;
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    box-shadow: inset 0 1px 0 0 rgba(255, 255, 255, 0.08), 0 4px 20px rgba(0, 0, 0, 0.35);
    transition: all 0.35s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .legacy-hero-{{ section.id }} .legacy-btn--secondary:hover {
    background: var(--btn2-bg-hover) !important;
    background-color: var(--btn2-bg-hover) !important;
    color: var(--btn2-text-hover) !important;
    border-color: var(--btn2-border-hover) !important;
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    transform: translateY(-2px);
    box-shadow: 
      inset 0 1px 0 0 rgba(255, 255, 255, 0.15),
      0 0 25px rgba(220, 177, 79, 0.45),
      0 0 50px rgba(220, 177, 79, 0.2) !important;
  }



  /* Bottom 7 AND 10 Badge */

  .legacy-hero-{{ section.id }} .legacy-hero__bottom-badge {

    display: flex;

    flex-direction: column;

    align-items: center;

    gap: 6px;

    margin-top: 10px;

  }



  .legacy-hero-{{ section.id }} .legacy-hero__numbers {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 16px;
    font-family: 'Cormorant Garamond', serif;
    color: var(--accent-gold);
    line-height: 1;
  }

  .legacy-hero-{{ section.id }} .legacy-hero__num {
    font-size: {{ section.settings.badge_number_size | default: 38 }}px;
    font-weight: 700;
    line-height: 1;
    display: inline-block;
    vertical-align: middle;
    transition: filter 0.3s ease;
    will-change: filter;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
    text-rendering: optimizeLegibility;
    -webkit-backface-visibility: hidden;
    backface-visibility: hidden;
    transform: translateZ(0);
    -webkit-transform: translateZ(0);
  }

  {% if section.settings.enable_country_colors %}
    .legacy-hero-{{ section.id }} .legacy-hero__num--left {
      background: {{ section.settings.badge_left_gradient | default: 'linear-gradient(135deg, #DE2535 0%, #F5C642 50%, #047A46 100%)' }};
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
      color: transparent;
      filter: drop-shadow(0 2px 8px {{ section.settings.badge_left_glow | default: '#DE2535' }}55);
    }
    .legacy-hero-{{ section.id }} .legacy-hero__num--left:hover {
      filter: brightness(1.2) drop-shadow(0 2px 14px {{ section.settings.badge_left_glow | default: '#DE2535' }}90);
    }

    .legacy-hero-{{ section.id }} .legacy-hero__num--right {
      background: {{ section.settings.badge_right_gradient | default: 'linear-gradient(135deg, #74ACDF 0%, #FFFFFF 48%, #F6B40E 60%, #74ACDF 100%)' }};
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
      color: transparent;
      filter: drop-shadow(0 2px 8px {{ section.settings.badge_right_glow | default: '#74ACDF' }}55);
    }
    .legacy-hero-{{ section.id }} .legacy-hero__num--right:hover {
      filter: brightness(1.2) drop-shadow(0 2px 14px {{ section.settings.badge_right_glow | default: '#74ACDF' }}90);
    }
  {% else %}
    .legacy-hero-{{ section.id }} .legacy-hero__num--left,
    .legacy-hero-{{ section.id }} .legacy-hero__num--right {
      color: var(--accent-gold);
    }
    .legacy-hero-{{ section.id }} .legacy-hero__num:hover {
      filter: brightness(1.15) drop-shadow(0 2px 10px rgba(220, 177, 79, 0.4));
    }
  {% endif %}



  .legacy-hero-{{ section.id }} .legacy-hero__and {

    font-family: 'Jost', var(--g-font-2), sans-serif;

    font-size: {{ section.settings.badge_middle_size | default: 11 }}px;

    letter-spacing: 3px;

    color: var(--text-color);

    font-weight: 400;

  }



  .legacy-hero-{{ section.id }} .legacy-hero__bottom-text {

    font-family: 'Jost', var(--g-font-2), sans-serif;

    font-size: {{ section.settings.badge_subtext_size | default: 10 }}px;

    letter-spacing: 4px;

    text-transform: uppercase;

    color: var(--text-color);

    opacity: 0.85;

    font-weight: 500;

  }



  /* Left Alignment Overrides (Large / Desktop Screens Only) */
  @media (min-width: 769px) {
    {% if section.settings.content_alignment_desktop == 'left' %}
      .legacy-hero-{{ section.id }} .legacy-hero__subheading {
        text-align: left;
        margin-left: 0;
        margin-right: auto;
      }
      .legacy-hero-{{ section.id }} .legacy-hero__heading {
        text-align: left;
        margin-left: 0;
        margin-right: auto;
      }
      .legacy-hero-{{ section.id }} .legacy-hero__description {
        text-align: left;
        margin: 0 0 32px 0;
      }
      .legacy-hero-{{ section.id }} .legacy-hero__actions {
        justify-content: flex-start;
        margin-left: 0;
        margin-right: auto;
      }
      .legacy-hero-{{ section.id }} .legacy-hero__bottom-badge {
        align-items: flex-start;
        margin-left: 0;
        margin-right: auto;
      }
    {% endif %}
  }

  /* Mobile Responsive */

  @media (max-width: 768px) {
    .legacy-hero-{{ section.id }} .legacy-hero__content {
      margin: 0 auto !important;
      text-align: center !important;
      align-items: center !important;
      justify-content: center !important;
      max-width: 100% !important;
      padding-top: {{ section.settings.mobile_content_padding_top | default: 35 }}px !important;
    }

    .legacy-hero-{{ section.id }} .legacy-hero__subheading {
      text-align: center !important;
      margin: 0 auto 8px auto !important;
      font-size: {{ section.settings.subheading_font_size_mobile | default: 12 }}px !important;
    }

    .legacy-hero-{{ section.id }} .legacy-hero__subheading::after {
      margin-left: auto !important;
      margin-right: auto !important;
    }

    .legacy-hero-{{ section.id }} .legacy-hero__heading {
      text-align: center !important;
      margin: 0 auto 20px auto !important;
      font-size: {{ section.settings.heading_font_size_mobile | default: 48 }}px !important;
      line-height: 1.15 !important;
    }

    .legacy-hero-{{ section.id }} .legacy-hero__heading span,
    .legacy-hero-{{ section.id }} .legacy-hero__heading small {
      text-align: center !important;
      margin: 2px auto 14px auto !important;
      padding-left: 0 !important;
      font-size: {{ section.settings.subtext_font_size_mobile | default: 12 }}px !important;
      letter-spacing: 4px !important;
    }

    .legacy-hero-{{ section.id }} .legacy-hero__heading span:nth-of-type(2),
    .legacy-hero-{{ section.id }} .legacy-hero__heading small:nth-of-type(2) {
      margin-top: 8px !important;
      margin-bottom: 14px !important;
      padding-left: 0 !important;
    }

    .legacy-hero-{{ section.id }} .legacy-hero__heading span::before,
    .legacy-hero-{{ section.id }} .legacy-hero__heading small::before {
      display: none !important;
    }

    .legacy-hero-{{ section.id }} .legacy-hero__actions {
      justify-content: center !important;
      margin-left: auto !important;
      margin-right: auto !important;
    }

    .legacy-hero-{{ section.id }} .legacy-hero__bottom-badge {
      align-items: center !important;
    }


    .legacy-hero-{{ section.id }} {

      padding: 0px 15px;
  align-items:flex-start!important;
      min-height: var(--mobile-height, 90vh) !important;

      {% if section.settings.bg_image_mobile != blank %}

        background-image: url('{{ section.settings.bg_image_mobile | image_url: width: 1500 }}') !important;

        background-size: cover !important;

        background-position: {{ section.settings.bg_position_mobile | default: 'center center' }} !important;

        background-repeat: no-repeat !important;

      {% elsif section.settings.bg_image != blank %}
        background-position: {{ section.settings.bg_position_mobile | default: 'center center' }} !important;
      {% else %}
        background-image: url('{{ 'goat-christmas-hero-banner.jpg' | asset_url }}') !important;
        background-size: cover !important;
        background-position: {{ section.settings.bg_position_mobile | default: 'center center' }} !important;
      {% endif %}

    }



    .legacy-hero-{{ section.id }}::before {

      background-color: var(--mobile-overlay-color);

      opacity: var(--mobile-overlay-opacity);

    }



    .legacy-hero-{{ section.id }} .legacy-hero__heading {

      font-size: 34px;

    }



    .legacy-hero-{{ section.id }} .legacy-hero__actions {

      flex-direction: column;

      align-items: center;

      gap: 12px;

      width: 100%;

    }



    .legacy-hero-{{ section.id }} .legacy-btn {

      width: 100%;

      max-width: 280px;

      padding: 12px 20px;

      font-size: 12px;

      letter-spacing: 1.4px;

      line-height: 1.2;

      white-space: nowrap;

      text-align: center;

      -webkit-font-smoothing: antialiased;

      -moz-osx-font-smoothing: grayscale;

      text-rendering: optimizeLegibility;

    }



    .legacy-hero-{{ section.id }} .legacy-btn--primary {

      padding: 12px 20px;

      font-size: 12px;

      letter-spacing: 1.3px;

      white-space: nowrap;

    }

      .legacy-hero-{{ section.id }} .legacy-hero__num {
      font-size: {{ section.settings.badge_number_size_mobile | default: 28 }}px;
    }

    .legacy-hero-{{ section.id }} .legacy-hero__and {
      font-size: {{ section.settings.badge_middle_size | default: 11 | times: 0.9 | round }}px;
    }

    .legacy-hero-{{ section.id }} .legacy-hero__bottom-text {
      font-size: {{ section.settings.badge_subtext_size | default: 10 | times: 0.9 | round }}px;
      letter-spacing: 3px;
    }
  }

</style>



<div class="legacy-hero-{{ section.id }}">

  {% if section.settings.enable_blur_overlay %}
    <div class="legacy-hero__blur-overlay"></div>
  {% endif %}

  <!-- Center Content -->

  <div class="legacy-hero__content">

    {% if section.settings.subheading != blank %}
      <div class="legacy-hero__subheading">{{ section.settings.subheading }}</div>
    {% endif %}

    {% if section.settings.heading != blank %}
      {% if section.settings.heading contains '<div' or section.settings.heading contains '<style' %}
        {{ section.settings.heading }}
      {% else %}
        <h1 class="legacy-hero__heading">
          {% if section.settings.heading contains '|' %}
            {% assign heading_formatted = section.settings.heading | newline_to_br | replace: '<br />', '<br>' | replace: '<br/>', '<br>' %}
            {% assign lines = heading_formatted | split: '<br>' %}
            {% for line in lines %}
              {% assign clean_line = line | strip %}
              {% if clean_line != blank %}
                {% if clean_line contains '|' %}
                  {% assign parts = clean_line | split: '|' %}
                  {{ parts[0] | strip }}
                  <span>{{ parts[1] | strip }}</span>
                {% else %}
                  {{ clean_line }}
                {% endif %}
              {% endif %}
            {% endfor %}
          {% else %}
            {{ section.settings.heading | newline_to_br }}
          {% endif %}
        </h1>
      {% endif %}
    {% endif %}

    {% unless section.settings.heading contains '<div' or section.settings.heading contains '<style' %}
      {% if section.settings.description != blank %}
        <div class="legacy-hero__description">{{ section.settings.description }}</div>
      {% endif %}

      <!-- Action Buttons -->
      <div class="legacy-hero__actions">
        {% if section.settings.btn1_text != blank %}
          <a href="{{ section.settings.btn1_link | default: '#' }}" class="legacy-btn legacy-btn--primary">
            {{ section.settings.btn1_text }}
          </a>
        {% endif %}

        {% if section.settings.btn2_text != blank %}
          <a href="{{ section.settings.btn2_link | default: '#' }}" class="legacy-btn legacy-btn--secondary">
            {{ section.settings.btn2_text }}
          </a>
        {% endif %}
      </div>
    {% endunless %}



    <!-- Bottom Numbers Badge -->

    {% if section.settings.show_bottom_badge %}

      <div class="legacy-hero__bottom-badge">

        <div class="legacy-hero__numbers">
          <span class="legacy-hero__num legacy-hero__num--left">{{ section.settings.left_number }}</span>
          <span class="legacy-hero__and">{{ section.settings.middle_text }}</span>
          <span class="legacy-hero__num legacy-hero__num--right">{{ section.settings.right_number }}</span>
        </div>

        {% if section.settings.bottom_text != blank %}

          <span class="legacy-hero__bottom-text">{{ section.settings.bottom_text }}</span>

        {% endif %}

      </div>

    {% endif %}

  </div>

</div>



