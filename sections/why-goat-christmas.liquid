{% comment %}
  Section: Why Goat Christmas Component without Bottom Box
{% endcomment %}

<div class="why-goat-section-wrapper-{{ section.id }}">
  <div class="why-goat-container">
    
    <!-- Top Icon -->
    {%- if section.settings.top_icon_svg != blank -%}
      <div class="why-goat-top-icon">
        {{ section.settings.top_icon_svg }}
      </div>
    {%- endif -%}

    <!-- Main Title -->
    <h2 class="why-goat-title">
      <span class="title-main">{{ section.settings.title_line1 }}</span>
      <span class="title-highlight">{{ section.settings.title_line2 }}</span>
    </h2>

    <!-- Description Paragraph -->
    <p class="why-goat-desc">
      {{ section.settings.description_text }}
    </p>

    <!-- Cards Grid (Dynamic Blocks) -->
    <div class="why-goat-cards-grid">
      {%- for block in section.blocks -%}
        <div class="why-goat-card" {{ block.shopify_attributes }}>
          {%- if block.settings.card_icon_svg != blank -%}
            <div class="card-icon">
              {{ block.settings.card_icon_svg }}
            </div>
          {%- endif -%}
          <h3 class="card-title">{{ block.settings.card_title }}</h3>
          <p class="card-desc">{{ block.settings.card_desc }}</p>
        </div>
      {%- endfor -%}
    </div>

  </div>
</div>

<style>
  .why-goat-section-wrapper-{{ section.id }} {
    background-color: {{ section.settings.bg_color }};
    {%- if section.settings.bg_gradient != blank -%}
      background: {{ section.settings.bg_gradient }};
    {%- endif -%}
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    padding-left: 20px;
    padding-right: 20px;
    width: 100%;
    box-sizing: border-box;
    display: flex;
    justify-content: center;
  }

  .why-goat-container {
    max-width: 1100px;
    width: 100%;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  /* Top Icon Style */
  .why-goat-top-icon {
    color: {{ section.settings.accent_color }};
    width: 36px;
    height: 36px;
    margin-bottom: 20px;
    display: flex;
    justify-content: center;
    align-items: center;
  }
  .why-goat-top-icon svg {
    width: 100%;
    height: 100%;
  }

  /* Main Title Style */
  .why-goat-title {
    margin: 0 0 25px 0;
    line-height: 1.2;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .title-main {
    color: {{ section.settings.title_color }};
    font-size: {{ section.settings.title_font_size }}px;
    font-weight: 800;
    letter-spacing: 1.5px;
    text-transform: uppercase;
  }

  .title-highlight {
    color: {{ section.settings.accent_color }};
    font-size: {{ section.settings.title_font_size }}px;
    font-weight: 700;
  }

  /* Description Style */
  .why-goat-desc {
    color: {{ section.settings.desc_color }};
    font-size: {{ section.settings.desc_font_size }}px;
    line-height: 1.7;
    max-width: 850px;
    margin: 0 auto 50px auto;
    font-weight: 300;
  }

  /* Cards Grid Style */
  .why-goat-cards-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 25px;
    width: 100%;
  }

  .why-goat-card {
    background-color: {{ section.settings.card_bg_color }};
    border: 1px solid {{ section.settings.card_border_color }};
    border-radius: 16px;
    padding: 35px 25px;
    text-align: center;
    box-shadow: 0 10px 30px rgba(0,0,0,0.4);
    display: flex;
    flex-direction: column;
    align-items: center;
    transition: transform 0.3s ease;
  }

  .why-goat-card:hover {
    transform: translateY(-5px);
  }

  .card-icon {
    color: {{ section.settings.accent_color }};
    width: 28px;
    height: 28px;
    margin-bottom: 20px;
    display: flex;
    justify-content: center;
    align-items: center;
  }
  .card-icon svg {
    width: 100%;
    height: 100%;
  }

  .card-title {
    color: {{ section.settings.card_title_color }};
    font-size: {{ section.settings.card_title_font_size }}px;
    font-weight: 700;
    margin: 0 0 15px 0;
    letter-spacing: 1px;
  }

  .card-desc {
    color: {{ section.settings.card_desc_color }};
    font-size: {{ section.settings.card_desc_font_size }}px;
    line-height: 1.6;
    margin: 0;
    font-weight: 300;
  }

  /* Responsive Design for Mobile Devices */
  @media screen and (max-width: 768px) {
    .why-goat-section-wrapper-{{ section.id }} {
      padding-top: {{ section.settings.padding_top | times: 0.6 }}px;
      padding-bottom: {{ section.settings.padding_bottom | times: 0.6 }}px;
      padding-left: 15px;
      padding-right: 15px;
    }

    .why-goat-cards-grid {
      grid-template-columns: 1fr;
      gap: 20px;
    }

    .title-main, .title-highlight {
      font-size: {{ section.settings.title_font_size | times: 0.55 }}px;
    }

    .why-goat-desc {
      font-size: {{ section.settings.desc_font_size | times: 0.85 }}px;
      margin-bottom: 35px;
    }
  }
</style>

