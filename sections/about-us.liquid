        {
          "type": "color",
          "id": "background",
          "label": "Background",
          "default": "#FAF5EB"
        },
        {
          "type": "color",
          "id": "text_color",
          "label": "Text color",
          "default": "#282119"
        },
        {
          "type": "color",
          "id": "accent",
          "label": "Accent color",
          "default": "#987025"
        },
